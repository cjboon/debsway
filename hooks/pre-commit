#!/bin/sh
# Runs shellcheck on every shell script before each commit, and refuses
# the commit if it finds a problem. Turn it on once per clone with:
#   git config core.hooksPath hooks
command -v shellcheck >/dev/null || { echo "pre-commit: install shellcheck (sudo apt install shellcheck)" >&2; exit 1; }
cd "$(git rev-parse --show-toplevel)" || exit 1
files=$(git ls-files '*.sh' 'bin/*')
[ -n "$files" ] || exit 0
# shellcheck disable=SC2086
shellcheck $files || { echo "pre-commit: fix the shellcheck findings above, then commit again." >&2; exit 1; }
