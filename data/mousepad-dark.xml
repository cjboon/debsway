<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wren Linux's dark scheme for Mousepad (GtkSourceView 4): white text on black,
  in the colors of Wren Linux's terminal (data/foot.ini). extras/mousepad.sh
  installs it as ~/.local/share/gtksourceview-4/styles/wren-dark.xml.
-->
<style-scheme id="wren-dark" name="Wren Linux dark" version="1.0">
  <author>Wren Linux</author>
  <description>White text on black, in the colors of Wren Linux's terminal</description>

  <color name="black"   value="#000000"/>
  <color name="text"    value="#dcdcdc"/>
  <color name="white"   value="#ffffff"/>
  <color name="dim"     value="#72898f"/>
  <color name="shade"   value="#184956"/>
  <color name="shade2"  value="#2d5b69"/>
  <color name="faint"   value="#1a1a1a"/>
  <color name="red"     value="#fa5750"/>
  <color name="green"   value="#75b938"/>
  <color name="yellow"  value="#dbb32d"/>
  <color name="byellow" value="#ebc13d"/>
  <color name="blue"    value="#4695f7"/>
  <color name="magenta" value="#f275be"/>
  <color name="cyan"    value="#41c7b9"/>

  <!-- The page -->
  <style name="text"                     foreground="text" background="black"/>
  <style name="selection"                foreground="white" background="shade"/>
  <style name="cursor"                   foreground="white"/>
  <style name="secondary-cursor"         foreground="dim"/>
  <style name="current-line"             background="faint"/>
  <style name="line-numbers"             foreground="dim" background="black"/>
  <style name="draw-spaces"              foreground="shade2"/>
  <style name="background-pattern"       background="faint"/>
  <!-- The line on the right that shows how long lines should be -->
  <style name="right-margin"             foreground="dim" background="faint"/>
  <!-- Matching braces -->
  <style name="bracket-match"            foreground="black" background="byellow" bold="true"/>
  <style name="bracket-mismatch"         foreground="white" background="red"/>
  <style name="search-match"             foreground="black" background="cyan"/>

  <!-- Code -->
  <style name="def:comment"              foreground="dim" italic="true"/>
  <style name="def:shebang"              foreground="dim" bold="true"/>
  <style name="def:doc-comment-element"  italic="true"/>
  <style name="def:constant"             foreground="magenta"/>
  <style name="def:string"               foreground="green"/>
  <style name="def:special-char"         foreground="cyan"/>
  <style name="def:special-constant"     foreground="magenta"/>
  <style name="def:floating-point"       foreground="magenta"/>
  <style name="def:identifier"           foreground="blue"/>
  <style name="def:statement"            foreground="yellow" bold="true"/>
  <style name="def:type"                 foreground="cyan" bold="true"/>
  <style name="def:preprocessor"         foreground="magenta"/>
  <style name="def:error"                foreground="white" background="red" bold="true"/>
  <style name="def:warning"              foreground="black" background="yellow"/>
  <style name="def:note"                 foreground="black" background="byellow" bold="true"/>
  <style name="def:net-address"          foreground="blue" underline="single"/>

  <!-- Markdown and other markup -->
  <style name="def:emphasis"             italic="true"/>
  <style name="def:strong-emphasis"      foreground="white" bold="true"/>
  <style name="def:inline-code"          foreground="cyan"/>
  <style name="def:insertion"            underline="single"/>
  <style name="def:deletion"             strikethrough="true"/>
  <style name="def:link-text"            foreground="blue"/>
  <style name="def:link-symbol"          foreground="dim" bold="true"/>
  <style name="def:link-destination"     foreground="dim" italic="true" underline="single"/>
  <style name="def:heading"              foreground="yellow" bold="true"/>
  <style name="def:thematic-break"       foreground="dim" bold="true"/>
  <style name="def:preformatted-section" foreground="cyan"/>
  <style name="def:list-marker"          foreground="yellow" bold="true"/>

  <!-- diff -->
  <style name="diff:added-line"          foreground="green"/>
  <style name="diff:removed-line"        foreground="red"/>
  <style name="diff:changed-line"        foreground="yellow"/>
  <style name="diff:diff-file"           foreground="white" bold="true"/>
  <style name="diff:location"            foreground="cyan"/>
  <style name="diff:special-case"        foreground="white" bold="true"/>
</style-scheme>
