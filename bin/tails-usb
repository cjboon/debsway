#!/bin/sh
# tails-usb: written by Wren Linux extras/tails-usb.sh
# Makes a Tails USB stick: downloads the newest Tails (through Tor when Tor runs
# here), checks its signature and that it is the current release, writes it to
# a USB stick you pick and type the name of, and reads it back to check.
# Everything on the stick is erased. A checked copy is kept for the next stick.
# Where Wren Linux is: WREN_DIR if you set it; else the root-owned copy the
# Wren Linux package installs, which no program running as you can change; else
# your own copy, ~/wren
if [ -n "${WREN_DIR:-}" ]; then
    DIR=$WREN_DIR
elif [ -f "${WREN_SYSTEM_DIR:-/usr/share/wren}/lib.sh" ]; then
    DIR=${WREN_SYSTEM_DIR:-/usr/share/wren}
else
    DIR=$HOME/wren
fi
[ -f "$DIR/extras/tails-usb.sh" ] || { echo "tails-usb: can't find the Wren Linux folder ($DIR). Set WREN_DIR to where it is." >&2; exit 1; }
exec bash "$DIR/extras/tails-usb.sh" --make "$@"
