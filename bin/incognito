#!/bin/bash
# incognito [--no-audio] [--signin] [URL]: written by Wren Linux parts/incognito.sh
# Opens Firefox as a different, locked-down user (incognito), inside its own
# small window system, so it shares no clipboard and no folder with you.
# Everything it stores is kept in memory and deleted when you close it.
# It gets a restricted Wayland socket (bin/wayland-restrict), not your real
# one: it can show a window, but sway doesn't offer it the screen-reading,
# typing or session-lock protocols.
# Sound: incognito runs its own audio server with no sound card; all it can
# do is write sound into one pipe, which a player of yours reads and plays.
# It never gets to your audio server, so it can't hear your microphone or
# your other programs.
# --signin: the Wi-Fi sign-in window (bin/wifi-signin): it uses the network's
# own DNS, not Firefox's encrypted DNS, so a sign-in page can load. It runs as
# another user, wifi-signin, whose firewall rule lets it reach the local
# network, where sign-in pages often are; it has no sound, and it can be open
# next to an incognito window.
set -euo pipefail

die() { printf 'incognito: %s\n' "$*" >&2; exit 1; }

audio=true kind=normal
if [ "${1:-}" = --no-audio ]; then audio=false; shift; fi
if [ "${1:-}" = --signin ]; then kind=signin; shift; fi
# Who it runs as: each kind its own user, with its own firewall rule
user=incognito
if [ "$kind" = signin ]; then user=wifi-signin audio=false; fi

[ "$(id -u)" -ne 0 ] || die "run it as your normal user, not root."
[ -n "${WAYLAND_DISPLAY:-}" ] || die "it needs your sway session; start sway first."
rt=${XDG_RUNTIME_DIR:-}
[ -n "$rt" ] && [ -d "$rt" ] || die "XDG_RUNTIME_DIR isn't set."
case $WAYLAND_DISPLAY in
    */*) die "WAYLAND_DISPLAY should be a plain name like wayland-1." ;;
esac
[ -S "$rt/$WAYLAND_DISPLAY" ] || die "can't find your Wayland socket ($rt/$WAYLAND_DISPLAY)."
# wayland-restrict is yours, in ~/.local/bin: taken from there, so a link from a
# program whose PATH leaves that out (Wren Linux's own scripts) still opens
restrict=$HOME/.local/bin/wayland-restrict
[ -x "$restrict" ] || restrict=$(command -v wayland-restrict) || die "wayland-restrict is missing. Run: wrenctl part incognito"
command -v setfacl >/dev/null || die "setfacl is missing (package acl)."
command -v flock >/dev/null || die "flock is missing (package util-linux)."
# The one command your user may run as incognito or wifi-signin (see /etc/sudoers.d)
sudo -n -u "$user" -l /usr/local/libexec/incognito-session >/dev/null 2>&1 ||
    die "your user isn't set up to start it. Run: wrenctl part incognito"

# One of each kind at a time: the second would take back the access the first one needs
exec 9>"$rt/$user.lock"
flock -n 9 || die "it is already open."

# What it is handed (the restricted socket, the sound pipe) is in a new folder
# of its own, with a name nobody can guess, and passage is given to that alone.
# Never through your runtime folder: that also leads to every socket in it, and
# your audio server's (pipewire-0, pulse/native) are open to anyone who reaches
# them, with your microphones and camera behind them. (incognito-session accepts
# only such a folder.)
SHARE_ROOT=${WREN_SHARE_ROOT:-/dev/shm}
[ -d "$SHARE_ROOT" ] || die "$SHARE_ROOT (memory) isn't available."
# Left by a crash or a power cut (the lock above says this one isn't running)
find "$SHARE_ROOT" -maxdepth 1 -user "$(id -un)" -name "wren-$user.*" -exec rm -rf {} + 2>/dev/null || true
share=$(mktemp -d "$SHARE_ROOT/wren-$user.XXXXXXXX") || die "couldn't make a folder in $SHARE_ROOT."
trap 'rm -rf "$share"' EXIT
# An older version's passage, if it ended without taking it back
setfacl -x "u:$user" "$rt" 2>/dev/null || true
sock=$share/$user-wayland

# The sound pipe: incognito writes, a player of yours reads and plays it.
# Only raw sound can come through it.
fifo=$share/incognito-audio.fifo
player=
if $audio && command -v pw-cat >/dev/null && [ -S "$rt/pipewire-0" ]; then
    :
else
    audio=false
fi

# incognito may only reach the restricted Wayland socket (and the sound pipe),
# and only while it runs.
# shellcheck disable=SC2317,SC2329  # runs from the EXIT trap
cleanup() {
    if [ -n "$player" ]; then kill "$player" 2>/dev/null || true; fi
    if [ -n "${WL_PID:-}" ]; then kill "$WL_PID" 2>/dev/null || true; fi
    rm -rf "$share"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
# 9>&-: wayland-restrict must not inherit the lock. It ends when cleanup
# kills it, or when this script dies (its standard input closes).
coproc WL { "$restrict" "$sock" "$user" 9>&-; }
IFS= read -r -t 10 line <&"${WL[0]}" && [ "$line" = ready ] ||
    die "couldn't make a restricted Wayland socket (needs sway 1.9 or newer; see above)."
setfacl -m "u:$user:--x" "$share"
setfacl -m "u:$user:rw-" "$sock"

if $audio; then
    mkfifo -m 600 "$fifo"
    setfacl -m u:incognito:rw- "$fifo"
    # Opening the pipe waits until incognito's sound server opens its end.
    # This is the only thing of yours it can send sound to, and it is a
    # normal stream in your volume control.
    # 9>&-: the player must not inherit the lock, or it outlives us holding it
    ( exec pw-cat -p -a --format s16 --rate 48000 --channels 2 --media-role Movie - <"$fifo" 9>&- ) &
    player=$!
    audio_arg=incognito-audio.fifo
else
    audio_arg=-
fi

rc=0
# the theme (bin/theme): just the word light or dark
theme=$(head -c 16 "${XDG_CONFIG_HOME:-$HOME/.config}/wren/theme" 2>/dev/null || true)
case $theme in light | dark) ;; *) theme=dark ;; esac
sudo -n -u "$user" /usr/local/libexec/incognito-session "$share" "${sock##*/}" "$audio_arg" "$theme" "$kind" "$@" || rc=$?
exit "$rc"
