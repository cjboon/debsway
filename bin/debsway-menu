#!/bin/bash
# debsway-menu: written by debsway parts/debsway-menu.sh
# The menu behind the "debsway" item in the bar. A click opens a black-and-gray
# terminal that fills the space under the bar with the choices: Help, Install apps, Update,
# Status. Arrow keys (or j/k) and Enter choose; so does a click. Esc or q
# closes it. What you choose runs in that same window, and the window closes
# when it ends (the install and update screens wait for Enter first, if they
# did something you may want to read). The last three need the debsway folder
# (~/debsway, or DEBSWAY_DIR); without it only Help shows.
#   debsway-menu          open the window
#   debsway-menu --tui    the menu itself, in the terminal you are in
DIR=${DEBSWAY_DIR:-$HOME/debsway}

# The terminal's colors, all gray: black screen, light gray text. The eight
# normal and eight bright colors programs ask for (red warnings, green
# headings...) come out as shades, so nothing is colored.
gray_options() {
    local i=0 c
    printf '%s\n' -o colors.foreground=d0d0d0 -o colors.background=000000 \
        -o colors.selection-foreground=000000 -o colors.selection-background=d0d0d0 -o colors.alpha=1.0
    for c in 000000 9a9a9a b8b8b8 c8c8c8 8a8a8a a8a8a8 bcbcbc d0d0d0; do
        printf '%s\n' -o "colors.regular$i=$c"
        i=$((i + 1))
    done
    i=0
    for c in 606060 aaaaaa d8d8d8 e0e0e0 9a9a9a b8b8b8 d0d0d0 ffffff; do
        printf '%s\n' -o "colors.bright$i=$c"
        i=$((i + 1))
    done
}

if [ "${1:-}" != --tui ]; then
    mapfile -t gray < <(gray_options)
    exec foot --app-id=debsway-run "${gray[@]}" "$(readlink -f -- "$0")" --tui
fi

# ---- the menu, in this terminal ----
items=(Help)
if [ -f "$DIR/update.sh" ]; then items+=("Install apps" Update Status); fi
n=${#items[@]}
sel=0
width=26
saved=$(stty -g 2>/dev/null)

finish() {
    printf '\e[?1000l\e[?1006l\e[?25h\e[?1049l'
    [ -z "$saved" ] || stty "$saved" 2>/dev/null
}
trap finish EXIT
trap 'exit 130' INT TERM HUP

# draw: the title, the choices (the chosen one reversed), and a hint, centered
draw() {
    local rows cols top left i y
    size=$(stty size 2>/dev/null || echo "24 80")
    read -r rows cols <<<"$size"
    top=$(((rows - n - 4) / 2 + 1))
    [ "$top" -ge 1 ] || top=1
    left=$(((cols - width) / 2 + 1))
    [ "$left" -ge 1 ] || left=1
    first_row=$((top + 2))
    first_col=$left
    printf '\e[2J\e[%d;%dH\e[1mdebsway\e[0m' "$top" "$left"
    for i in "${!items[@]}"; do
        y=$((first_row + i))
        if [ "$i" -eq "$sel" ]; then
            printf '\e[%d;%dH\e[7m %-*s \e[0m' "$y" "$left" $((width - 2)) "${items[i]}"
        else
            printf '\e[%d;%dH %-*s ' "$y" "$left" $((width - 2)) "${items[i]}"
        fi
    done
    printf '\e[%d;%dH\e[2marrows and Enter, or click. Esc closes.\e[0m' $((first_row + n + 1)) "$left"
}

# run_choice: leaves the menu and runs the chosen entry in this window
run_choice() {
    trap - EXIT
    finish
    case ${items[sel]} in
        Help) exec "$HOME/.local/bin/keys" ;;
        "Install apps") cd "$DIR" && export DEBSWAY_PAUSE=1 && exec bash install-extras.sh ;;
        Update) cd "$DIR" && export DEBSWAY_PAUSE=1 && exec bash update.sh ;;
        Status) cd "$DIR" && bash status.sh | less ; exit 0 ;;
    esac
}

printf '\e[?1049h\e[?25l\e[?1000h\e[?1006h'
stty -echo 2>/dev/null
first_row=1 first_col=1
while :; do
    draw
    # A new window starts small and sway stretches it a moment later, so the
    # size is looked at while waiting, and the menu redrawn (centered) when it
    # changes. read returns above 128 when nothing was typed in that time.
    while :; do
        IFS= read -rsn1 -t 0.25 key
        rc=$?
        [ "$rc" -ne 0 ] || break
        [ "$rc" -gt 128 ] || exit 0
        [ "$(stty size 2>/dev/null || echo "24 80")" = "$size" ] || draw
    done
    case $key in
        '') run_choice ;;                                  # Enter
        j) sel=$(((sel + 1) % n)) ;;
        k) sel=$(((sel + n - 1) % n)) ;;
        q) exit 0 ;;
        $'\e')
            # an arrow or a mouse report follows at once; nothing follows a plain Esc
            IFS= read -rsn1 -t 0.05 k2 || exit 0
            [ "$k2" = '[' ] || exit 0
            IFS= read -rsn1 -t 0.05 k3 || exit 0
            case $k3 in
                A) sel=$(((sel + n - 1) % n)) ;;
                B) sel=$(((sel + 1) % n)) ;;
                '<')
                    # mouse: button;column;row then M (press) or m (release)
                    report=
                    while IFS= read -rsn1 -t 0.05 c; do
                        [ "$c" = M ] || [ "$c" = m ] && break
                        report+=$c
                    done
                    IFS=';' read -r btn mx my <<<"$report"
                    if [ "$c" = M ]; then
                        case $btn in
                            64) sel=$(((sel + n - 1) % n)) ;;
                            65) sel=$(((sel + 1) % n)) ;;
                            0)
                                i=$((my - first_row))
                                if [ "$i" -ge 0 ] && [ "$i" -lt "$n" ] &&
                                    [ "$mx" -ge "$first_col" ] && [ "$mx" -lt $((first_col + width)) ]; then
                                    sel=$i
                                    run_choice
                                fi ;;
                        esac
                    fi ;;
            esac ;;
    esac
done
