#!/bin/bash
# ublock-allow: sites allowed to load scripts and frames from other sites.
# Written by debsway parts/firefox-hardening.sh.
#
# uBlock Origin runs in one of two modes for every Firefox profile, chosen
# when the sandboxed Firefox is installed (extras/firefox-sandbox.sh):
#   standard  its filter lists block ads, trackers and known malware sites;
#             the rest of a site runs, so sites work
#   medium    besides, scripts and frames from other sites (ad networks,
#             trackers, most malicious ads) are blocked everywhere; when a
#             site breaks because of it, allow that site here
# uBlock reads these rules at every start, so clicks in its popup only last
# until Firefox restarts; this list stays.
#
#   ublock-allow example.com          allow example.com (and its subdomains)
#   ublock-allow --remove example.com
#   ublock-allow --list               the mode, and the sites allowed
#   ublock-allow --mode standard|medium
#   ublock-allow --refresh            write it again (the secure DNS extra does,
#                                     when it is installed or removed)
# Restart Firefox afterwards.
set -euo pipefail

ETC=${DEBSWAY_FIREFOX_ETC:-/etc/firefox-esr}
LIST="$ETC/debsway-ublock-allow"
# standard or medium; no file: medium, as debsway was before the choice
MODE_FILE="$ETC/debsway-ublock-mode"
# Firefox's own DNS (DNSOverHTTPS below) depends on the secure DNS extra, whose
# settings file says it is installed, and on the choice made at the sandboxed
# Firefox's install (dns=strict or fallback)
SECURE_DNS=${DEBSWAY_SECURE_DNS_CONF:-/etc/unbound/unbound.conf.d/debsway-secure-dns.conf}
CHOICES=${DEBSWAY_FIREFOX_CHOICES:-/etc/debsway/firefox.conf}
QUAD9_DOH=https://dns.quad9.net/dns-query
# Debian's Firefox only finds policies.json in its install folder (it looks
# in /etc/firefox-esr/policies too, but the Debian build never reads it)
DIST=${DEBSWAY_FIREFOX_DIST:-/usr/share/firefox-esr/distribution}
POLICY="$DIST/policies.json"
OURS="$DIST/.debsway-written"
OLD="$ETC/policies"  # where an earlier debsway put it, which Firefox ignored
if [ "$(id -u)" -eq 0 ] || [ -n "${DEBSWAY_FIREFOX_ETC:-}" ]; then SUDO=; else SUDO=sudo; fi

die() { printf 'ublock-allow: %s\n' "$*" >&2; exit 1; }

# A bare host name: no scheme, path, port or capitals
site_of() {
    local s=${1,,}
    s=${s#*://}
    s=${s%%/*}
    s=${s%%:*}
    s=${s#www.}
    [[ $s =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] ||
        die "\"$1\" doesn't look like a site name, e.g. example.com"
    echo "$s"
}

sites() { [ -f "$LIST" ] && grep -v '^#' "$LIST" | grep . || true; }
mode() { if [ "$(head -c 16 "$MODE_FILE" 2>/dev/null)" = standard ]; then echo standard; else echo medium; fi; }
# doh: the DNSOverHTTPS policy. With the secure DNS extra the system's DNS is
# already encrypted (and the one way out): Firefox's own is off. Without it,
# Firefox encrypts its own lookups, to Quad9; strict (never plain DNS, so
# Wi-Fi sign-in pages don't load in Firefox) unless fallback was chosen.
doh() {
    local fallback=false
    if [ -f "$SECURE_DNS" ]; then
        echo '{ "Enabled": false, "Locked": true }'
        return
    fi
    [ "$(sed -n 's/^dns=//p' "$CHOICES" 2>/dev/null | head -1)" != fallback ] || fallback=true
    printf '{ "Enabled": true, "ProviderURL": "%s", "Fallback": %s, "Locked": true }\n' "$QUAD9_DOH" "$fallback"
}

# The policy: uBlock's own default rules, block other sites' scripts and
# frames everywhere, then the allowed sites. uBlock wants it as a JSON
# string inside the JSON, hence the double escaping.
write_policy() {
    local rules=() s inner sum
    rules=('behind-the-scene * * noop' 'behind-the-scene * image noop'
        'behind-the-scene * 3p noop' 'behind-the-scene * inline-script noop'
        'behind-the-scene * 1p-script noop' 'behind-the-scene * 3p-script noop'
        'behind-the-scene * 3p-frame noop')
    # medium mode: other sites' scripts and frames blocked everywhere
    [ "$(mode)" != medium ] || rules+=('* * 3p-script block' '* * 3p-frame block')
    while read -r s; do
        [ -n "$s" ] && rules+=("$s * 3p-script noop" "$s * 3p-frame noop")
    done < <(sites)
    inner=$(printf '%s\\n' "${rules[@]}")
    inner="{\"userSettings\":{\"advancedUserEnabled\":true},\"dynamicFilteringString\":\"${inner%\\n}\"}"
    inner=$(sed 's/\\/\\\\/g; s/"/\\"/g' <<<"$inner")
    $SUDO mkdir -p "$DIST"
    # Firefox reads one policies.json, so debsway's other Firefox policies live
    # here too (parts/firefox-hardening.sh has no separate file to put them in):
    #   SearchEngines.Default  - DuckDuckGo is the default search engine (Firefox
    #                            locks the default engine to enterprise policy).
    #   SearchEngines.DefaultPrivate - the same for private windows, which have
    #                            their own default (incognito is one all the time).
    #   ExtensionSettings      - uBlock runs in private windows (off by default
    #                            for every add-on; incognito is private all the time).
    #   Override*Page          - no Mozilla first-run or what's-new tabs; Firefox
    #                            opens straight to the home page.
    #   DNSOverHTTPS           - locked: off with the secure DNS extra (Firefox
    #                            looks names up the way the rest of the system
    #                            does, encrypted); without it, on, to Quad9
    #                            (doh above), never a provider of Firefox's
    #                            own choosing.
    printf '{\n  "policies": {\n    "SearchEngines": { "Default": "DuckDuckGo", "DefaultPrivate": "DuckDuckGo" },\n    "OverrideFirstRunPage": "",\n    "OverridePostUpdatePage": "",\n    "DNSOverHTTPS": %s,\n    "ExtensionSettings": {\n      "uBlock0@raymondhill.net": { "private_browsing": true }\n    },\n    "3rdparty": {\n      "Extensions": {\n        "uBlock0@raymondhill.net": {\n          "adminSettings": "%s"\n        }\n      }\n    }\n  }\n}\n' "$(doh)" "$inner" |
        $SUDO tee "$POLICY" >/dev/null
    sum=$(sha256sum "$POLICY")
    echo "$sum" | $SUDO tee "$OURS" >/dev/null
    # The earlier, unread copy, if it is still ours
    if [ -f "$OLD/.debsway-written" ] && sha256sum --status -c "$OLD/.debsway-written" 2>/dev/null; then
        $SUDO rm -f "$OLD/policies.json" "$OLD/.debsway-written"
        $SUDO rmdir "$OLD" 2>/dev/null || true
    fi
}

# Someone else's policies.json is left alone, before anything changes
policy_is_ours() {
    if [ -f "$POLICY" ] && ! { [ -f "$OURS" ] && sha256sum --status -c "$OURS" 2>/dev/null; }; then
        die "$POLICY exists and wasn't written by debsway. Add uBlock's settings to it by hand."
    fi
}

case "${1:-}" in
    --remove | --refresh | --mode) policy_is_ours ;;
    --list | "" | -*) ;;
    *) policy_is_ours ;;
esac

case "${1:-}" in
    --list | "")
        echo "uBlock Origin: $(mode) mode"
        if [ -n "$(sites)" ]; then sites; else echo "(no sites allowed yet)"; fi
        [ -n "${1:-}" ] || echo "Usage: ublock-allow SITE | --remove SITE | --list | --mode standard|medium"
        ;;
    --mode)
        case ${2:-} in standard | medium) ;; *) die "Usage: ublock-allow --mode standard|medium" ;; esac
        echo "$2" | $SUDO tee "$MODE_FILE" >/dev/null
        write_policy
        echo "uBlock Origin: $2 mode. Restart Firefox for it to take effect."
        ;;
    --remove)
        [ $# -eq 2 ] || die "Usage: ublock-allow --remove SITE"
        site=$(site_of "$2")
        { echo "# Written by ublock-allow; one site per line"; sites | grep -vxF "$site" || true; } |
            $SUDO tee "$LIST.new" >/dev/null
        $SUDO mv "$LIST.new" "$LIST"
        write_policy
        echo "Removed $site. Restart Firefox for it to take effect."
        ;;
    --refresh)
        write_policy
        ;;
    -*)
        die "Usage: ublock-allow SITE | --remove SITE | --list | --mode standard|medium"
        ;;
    *)
        site=$(site_of "$1")
        { echo "# Written by ublock-allow; one site per line"; sites | grep -vxF "$site" || true; echo "$site"; } |
            $SUDO tee "$LIST.new" >/dev/null
        $SUDO mv "$LIST.new" "$LIST"
        write_policy
        echo "Allowed $site to load scripts and frames from other sites. Restart Firefox for it to take effect."
        [ "$(mode)" = medium ] || echo "(uBlock is in standard mode, which doesn't block them anyway; this counts in medium mode.)"
        ;;
esac
