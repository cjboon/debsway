#!/bin/bash
# claude-session DIR [ARGS...]: written by Wren Linux extras/claude-code.sh
# Installed as /usr/local/libexec/claude-session. Your user may run exactly this,
# as claude-agent, and nothing else (a rule in /etc/sudoers.d). The claude
# command calls it from a folder inside ~/projects. The same goes for another
# account's user, claude-agent-NAME (claude --account NAME), with its own home.
set -euo pipefail

me=$(id -un)
[[ $me == claude-agent || $me =~ ^claude-agent-[a-z][a-z0-9]{0,14}$ ]] ||
    { echo "claude-session: only for the claude-agent users." >&2; exit 1; }
home=$(getent passwd "$me" | cut -d: -f6) || true
[ "$home" = "/home/$me" ] || { echo "claude-session: unexpected home folder for $me." >&2; exit 1; }
[ $# -ge 1 ] || { echo "usage: claude-session DIR [ARGS...]" >&2; exit 2; }
dir=$1
shift
cd -- "$dir" 2>/dev/null || { echo "claude-session: can't enter $dir" >&2; exit 1; }

export HOME=$home PATH=$home/.local/bin:/usr/local/bin:/usr/bin:/bin
export LANG=${LANG:-C.UTF-8}
# Claude Code's theme follows the terminal's, unless one was chosen already
seed_theme() { # CONFIG-FILE
    python3 -I - "$1" 2>/dev/null <<'PY' || true
import json, os, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
except FileNotFoundError:
    d = {}
if isinstance(d, dict) and "theme" not in d:
    d["theme"] = "auto"
    with os.fdopen(os.open(p + ".wren-new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(d, f, indent=2)
    os.replace(p + ".wren-new", p)
PY
}
seed_theme "$HOME/.claude.json"
# Before the first sign-in (no login saved yet), in a terminal: how to sign
# in, as the sandboxed Firefox can't finish Claude Code's own way
first_signin_note() { # CONFIG-FOLDER ARGS...
    local dir=$1
    shift
    [ ! -s "$dir/.credentials.json" ] && [ -z "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || return 0
    [ -t 0 ] && [ -t 1 ] || return 0
    case ${1:-} in -v | --version | -h | --help | -p | --print) return 0 ;; esac
    echo "Signing in to Claude: the sandboxed Firefox's firewall blocks the sign-in"
    echo "page's way back to this computer, so Claude Code can't finish it there. Open"
    echo "the link it prints in Firefox, sign in, and paste the code you get back here."
    read -rp 'Press Enter to go on. ' _ || true
}
first_signin_note "$HOME/.claude" "$@"
# Without a way to reach XWayland's abstract socket, which any user can connect to
noabs=/usr/local/libexec/wren-no-abstract-sockets
[ -x "$noabs" ] || { echo "claude-session: $noabs is missing. Run: bash extras/claude-code.sh" >&2; exit 1; }
exec "$noabs" /usr/bin/claude "$@"
