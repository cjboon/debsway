#!/bin/bash
# wren-menu: written by Wren Linux parts/wren-menu.sh
# The menu behind the "wren" item in the bar. A click opens a black-and-gray
# terminal in a floating, centered window. Its first screen: Web browser, Password
# manager, Terminal, then the lists Apps (Install apps, what you have, Remove apps),
# Wi-Fi (Choose a network, on or off, Sign-in page), Settings (Theme, Bluetooth,
# Microphone, Webcam, Vault, Secure DNS), System (Update, Status, Back up now,
# Startup programs) and Power (Lock, Suspend, Log out, Reboot, Shut down), and Help.
# Each shows only what is here. Arrow keys (or j/k) and Enter choose; so
# does a click. Esc goes back from a list, and closes the first screen, the
# install list and the pager. What you choose runs in that same window, and the
# window closes when it ends (the install and update screens wait for a key
# first, if they did something you may want to read). Install, Remove, Update and
# Status need the Wren Linux folder (~/wren, or WREN_DIR).
#   wren-menu              open the window
#   wren-menu --tui        the menu itself, in the terminal you are in
#   wren-menu --pager FILE show FILE: arrows, Space and b scroll, Esc closes
# Where Wren Linux is: WREN_DIR if you set it; else the root-owned copy the
# Wren Linux package installs, which no program running as you can change; else
# your own copy, ~/wren
if [ -n "${WREN_DIR:-}" ]; then
    DIR=$WREN_DIR
elif [ -f "${WREN_SYSTEM_DIR:-/usr/share/wren}/lib.sh" ]; then
    DIR=${WREN_SYSTEM_DIR:-/usr/share/wren}
else
    DIR=$HOME/wren
fi
KEYS_FILE=$HOME/.local/share/wren/keys.txt
[ -f "$KEYS_FILE" ] || KEYS_FILE=$DIR/data/keys.txt

# The terminal's colors, all gray: black screen, light gray text (in the light
# theme the other way round: bin/theme). The eight normal and eight bright
# colors programs ask for (red warnings, green headings...) come out as
# shades, so nothing is colored.
gray_options() {
    local i=0 c MENU_FG=d0d0d0 MENU_BG=000000
    local MENU_REGULAR="000000 9a9a9a b8b8b8 c8c8c8 8a8a8a a8a8a8 bcbcbc d0d0d0"
    local MENU_BRIGHT="606060 aaaaaa d8d8d8 e0e0e0 9a9a9a b8b8b8 d0d0d0 ffffff"
    # (theme env prints only checked colors: NAME='rrggbb ...')
    eval "$("$HOME/.local/bin/theme" env 2>/dev/null | grep -E "^MENU_(FG|BG|REGULAR|BRIGHT)='[0-9a-f ]+'\$")"
    printf '%s\n' -o "colors.foreground=$MENU_FG" -o "colors.background=$MENU_BG" \
        -o "colors.selection-foreground=$MENU_BG" -o "colors.selection-background=$MENU_FG" -o colors.alpha=0.85
    for c in $MENU_REGULAR; do
        printf '%s\n' -o "colors.regular$i=$c"
        i=$((i + 1))
    done
    i=0
    for c in $MENU_BRIGHT; do
        printf '%s\n' -o "colors.bright$i=$c"
        i=$((i + 1))
    done
}

if [ -z "$1" ]; then
    mapfile -t gray < <(gray_options)
    # --log-level=error: foot warns about a protocol sway lacks (the window icon), harmlessly
    # scrollback.multiplier=1: one step of the mouse wheel is one arrow key in
    # full-screen lists (the install checklist), not three
    exec foot --log-level=error --app-id=wren-run -o scrollback.multiplier=1.0 "${gray[@]}" "$(readlink -f -- "$0")" --tui
fi

# ---- inside the terminal ----
export LC_ALL=C.UTF-8   # so that cutting a line to the window's width counts characters
saved=$(stty -g 2>/dev/null)
# How long to wait for the rest of an arrow key or mouse report after an Esc
# byte. Nothing follows a plain Esc, so this is also how long Esc takes to close.
ESC_WAIT=${WREN_ESC_WAIT:-0.1}
size=
REDRAW=
KEY=
CX=0 CY=0

screen_on() { printf '\e[?1049h\e[?25l\e[?1000h\e[?1006h'; stty -echo 2>/dev/null; }
screen_off() {
    printf '\e[?1000l\e[?1006l\e[?25h\e[?1049l'
    [ -z "$saved" ] || stty "$saved" 2>/dev/null
}
trap screen_off EXIT
trap 'exit 130' INT TERM HUP

# settle: a new window starts at a small default size and sway stretches it a
# moment later. Drawing at once would show the menu off to one side and then
# jump, so wait (at most about half a second) until the size has stopped
# changing for a fraction of a second.
settle() {
    local prev cur same=0 i
    prev=$(stty size 2>/dev/null)
    for ((i = 0; i < 20; i++)); do
        sleep 0.03
        cur=$(stty size 2>/dev/null)
        if [ "$cur" = "$prev" ]; then
            same=$((same + 1))
            [ "$same" -lt 4 ] || return 0
        else
            same=0
            prev=$cur
        fi
    done
}

# on_idle: the window is a different size from when it was drawn (a new window
# starts small and sway stretches it a moment later): draw it again
on_idle() {
    [ -z "$REDRAW" ] || [ "$(stty size 2>/dev/null || echo "24 80")" = "$size" ] || "$REDRAW"
}

# waiting: the menu is about to wait for a key. Only when
# tools/test-wren-menu.sh asks (WREN_MENU_TEST_READY=1) it says so, with
# a terminal code that terminals ignore: the test then knows each key has been
# handled, instead of guessing how long that takes on a busy machine.
waiting() { [ -z "${WREN_MENU_TEST_READY:-}" ] || printf '\e]9999;wren-ready\a'; }

# wait_enter: for "Press Enter to go back" and the like
wait_enter() {
    waiting
    IFS= read -r _ </dev/tty || true
}

# read_key: waits for one key or mouse report and sets KEY to: up down pgup pgdn
# home end esc enter space click wheelup wheeldown other, or the character typed.
# A click also sets CX and CY (column and row, counted from 1).
read_key() {
    local c rc k2 k3 k4 report btn
    waiting
    while :; do
        IFS= read -rsn1 -t 0.1 c
        rc=$?
        [ "$rc" -ne 0 ] || break
        [ "$rc" -gt 128 ] || exit 0   # nothing more to read: the window is gone
        on_idle
    done
    case $c in
        '') KEY=enter ;;
        ' ') KEY=space ;;
        $'\e')
            KEY=esc   # nothing follows a plain Esc; an arrow or a mouse report follows at once
            IFS= read -rsn1 -t "$ESC_WAIT" k2 || return 0
            [ "$k2" = '[' ] || [ "$k2" = O ] || return 0
            IFS= read -rsn1 -t "$ESC_WAIT" k3 || return 0
            case $k3 in
                A) KEY=up ;;
                B) KEY=down ;;
                H) KEY=home ;;
                F) KEY=end ;;
                [0-9])
                    IFS= read -rsn1 -t "$ESC_WAIT" k4 || return 0   # the ~ that ends it
                    case $k3 in
                        1 | 7) KEY=home ;;
                        4 | 8) KEY=end ;;
                        5) KEY=pgup ;;
                        6) KEY=pgdn ;;
                        *) KEY=other ;;
                    esac ;;
                '<')
                    # mouse: button;column;row then M (press) or m (release)
                    report=
                    while IFS= read -rsn1 -t "$ESC_WAIT" c; do
                        if [ "$c" = M ] || [ "$c" = m ]; then break; fi
                        report+=$c
                    done
                    KEY=other
                    # three numbers, or nothing: bash arithmetic on CY would
                    # run whatever else came in (pasted text can look like this)
                    [[ $report =~ ^[0-9]{1,4}\;[0-9]{1,4}\;[0-9]{1,4}$ ]] || return 0
                    IFS=';' read -r btn CX CY <<<"$report"
                    if [ "$c" = M ]; then
                        case $btn in
                            0) KEY=click ;;
                            64) KEY=wheelup ;;
                            65) KEY=wheeldown ;;
                        esac
                    fi ;;
                *) KEY=other ;;
            esac ;;
        *) KEY=$c ;;
    esac
}

# ---- the pager ----
lines=()
top=0
page=20

pager_draw() {
    local rows cols i end maxtop
    size=$(stty size 2>/dev/null || echo "24 80")
    read -r rows cols <<<"$size"
    page=$((rows - 1))
    [ "$page" -ge 1 ] || page=1
    maxtop=$((${#lines[@]} - page))
    [ "$maxtop" -ge 0 ] || maxtop=0
    [ "$top" -le "$maxtop" ] || top=$maxtop
    [ "$top" -ge 0 ] || top=0
    end=$((top + page))
    [ "$end" -le "${#lines[@]}" ] || end=${#lines[@]}
    printf '\e[H\e[2J'
    for ((i = top; i < end; i++)); do printf '%s\e[0m\n' "${lines[i]:0:cols}"; done
    printf '\e[%d;1H\e[2mEsc closes. Arrows, Space and b scroll.  (%d-%d of %d)\e[0m' \
        "$rows" $((top + 1)) "$end" "${#lines[@]}"
}

# pager: shows `lines`; Esc (or q) ends the program
pager() {
    top=0
    REDRAW=pager_draw
    while :; do
        pager_draw
        read_key
        case $KEY in
            esc | q) exit 0 ;;
            down | j | enter) top=$((top + 1)) ;;
            up | k) top=$((top - 1)) ;;
            space | pgdn | f) top=$((top + page)) ;;
            pgup | b) top=$((top - page)) ;;
            home | g) top=0 ;;
            end | G) top=$((${#lines[@]} + 1000000)) ;;   # pager_draw brings it back to the last page
            wheeldown) top=$((top + 3)) ;;
            wheelup) top=$((top - 3)) ;;
        esac
    done
}

if [ "$1" = --pager ]; then
    [ -r "${2:-}" ] || { echo "wren-menu: can't read ${2:-a file}" >&2; exit 1; }
    mapfile -t lines <"$2"
    screen_on
    settle
    pager
fi
[ "$1" = --tui ] || { echo "usage: wren-menu [--tui | --pager FILE]" >&2; exit 2; }

# ---- the menu ----
# The first screen stays the same whatever is installed: what you open most, then
# the lists (Apps, Wi-Fi, Settings, System, Power), in words a newcomer would look
# for. ids say what an entry does; items are what it shows. Esc, or Back, goes from a
# list to the first screen.
# Wi-Fi, Bluetooth and the microphone are listed only when this computer has them
# (bin/radios), with their state; choosing one flips it and the menu stays open.
RADIOS=$HOME/.local/bin/radios
# web_browser: the browser links open in (mimeapps.list), or the first one
# installed; text_editor: Mousepad, if installed. Each prints its command, or nothing.
# (WREN_MENU_BROWSERS and WREN_MENU_EDITORS: a test's own lists)
BROWSERS=${WREN_MENU_BROWSERS-/usr/local/bin/firefox /usr/bin/firefox-esr /usr/bin/mullvad-browser}
EDITORS=${WREN_MENU_EDITORS-$HOME/.local/bin/mousepad /usr/bin/mousepad}
web_browser() {
    local app c
    app=$({ sed -n 's|^x-scheme-handler/https=||p' "$HOME/.config/mimeapps.list" 2>/dev/null || true; } | head -1)
    for c in $BROWSERS; do
        [ -x "$c" ] || continue
        case $app:${c##*/} in
            wren-firefox.desktop:firefox) echo "$c"; return ;;
        esac
    done
    for c in $BROWSERS; do [ -x "$c" ] && { echo "$c"; return; }; done
    return 0
}
text_editor() {
    local c
    for c in $EDITORS; do [ -x "$c" ] && { echo "$c"; return; }; done
    return 0
}
# app NAME...: the first of these commands that is installed, from APPS (where
# Wren Linux and Debian put them; WREN_MENU_APPS: a test's own list)
APPS=${WREN_MENU_APPS-/usr/bin/torbrowser-launcher $HOME/.local/bin/whonix $HOME/.local/bin/gimp $HOME/.local/bin/sparrow $HOME/.local/bin/feather /usr/bin/electrum /usr/bin/thunar /usr/bin/keepassxc /usr/bin/signal-desktop $HOME/.local/bin/simplex $HOME/.local/bin/claude $HOME/.local/bin/opencode-vm $HOME/.local/bin/vault $HOME/.local/bin/backup $HOME/.local/bin/wren-autostart $HOME/.local/bin/theme $HOME/.local/bin/secure-dns /usr/local/bin/wifi-signin}
app() {
    local want c
    for want; do
        for c in $APPS; do [ "${c##*/}" = "$want" ] && [ -x "$c" ] && { echo "$c"; return; }; done
    done
    return 0
}
# claude_cmd: Claude Code in a window of its own (claude asks which, if more than one)
claude_cmd() {
    local c
    c=$(app claude)
    [ -z "$c" ] || echo "foot --title=Claude -D $HOME $c"
}
IN_SWAY=
TOR_CMD='' WHONIX_CMD='' GIMP_CMD='' SPARROW_CMD='' FEATHER_CMD='' ELECTRUM_CMD='' BROWSER='' EDITOR_CMD='' FILES_CMD='' PASSWORDS_CMD='' CLAUDE_CMD='' SIGNAL_CMD='' SIMPLEX_CMD='' OPENCODE_CMD='' SIGNIN_CMD='' THEME_CMD=''
# (a terminal window, as Super+Enter opens: for a mouse, or where the keys don't
# arrive: sway in a VM's window, whose computer's own sway takes Super first)
if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null; then
    IN_SWAY=1
    BROWSER=$(web_browser) EDITOR_CMD=$(text_editor)
    FILES_CMD=$(app thunar) PASSWORDS_CMD=$(app keepassxc) CLAUDE_CMD=$(claude_cmd)
    SIGNAL_CMD=$(app signal-desktop) SIMPLEX_CMD=$(app simplex) OPENCODE_CMD=$(app opencode-vm)
    TOR_CMD=$(app torbrowser-launcher) WHONIX_CMD=$(app whonix) GIMP_CMD=$(app gimp)
    SPARROW_CMD=$(app sparrow) FEATHER_CMD=$(app feather) ELECTRUM_CMD=$(app electrum)
    # A throwaway window for a Wi-Fi sign-in page (it switches secure DNS off
    # while it is open, and on again after)
    SIGNIN_CMD=$(app wifi-signin)
fi
BACKUP_CMD=$(app backup) VAULT_CMD=$(app vault) SECDNS_CMD=$(app secure-dns) AUTOSTART_CMD=$(app wren-autostart)
# The theme (light or dark), inside sway: the console stays dark
if [ -n "${SWAYSOCK:-}${WAYLAND_DISPLAY:-}" ]; then THEME_CMD=$(app theme); fi
# Text size, on a text console only (console-only mode): there is no Terminal
# there, and the menu runs in the console itself
FONT_CMD=
if [ -z "${SWAYSOCK:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ -x "$HOME/.local/bin/console-font" ]; then
    FONT_CMD=$HOME/.local/bin/console-font
fi
HAS_UPDATE=
if [ -f "$DIR/update.sh" ]; then HAS_UPDATE=1; fi
# (WREN_MENU_NMTUI: a test's own; empty when NetworkManager isn't here)
NMTUI_CMD=${WREN_MENU_NMTUI-$(command -v nmtui || true)}
WIFI_SCRIPT=
if [ -f "$DIR/wifi.sh" ]; then WIFI_SCRIPT=1; fi
# radio_ids: all of them; wifi goes in the Wi-Fi list, the others in Settings
radio_ids=() HAS_WIFI='' other_radios=()
if [ -x "$RADIOS" ]; then
    mapfile -t radio_ids < <("$RADIOS" list 2>/dev/null | awk '{ print $1 }')
fi
for r in "${radio_ids[@]}"; do
    if [ "$r" = wifi ]; then HAS_WIFI=1; else other_radios+=("$r"); fi
done

# entry ID TEXT [SHOW]: an entry for this screen; with a third argument (a
# command found above), only if that isn't empty
entry() {
    [ $# -lt 3 ] || [ -n "$3" ] || return 0
    ids+=("$1")
    items+=("$2")
}
# build: the entries of the screen in level
build() {
    ids=() items=()
    case $level in
        top)
            # Inside sway, these two stay even before they are installed, to say how
            if [ -n "$BROWSER" ]; then entry browser "Web browser"
            elif [ -n "$IN_SWAY" ] && [ -n "$HAS_UPDATE" ]; then entry browser "Web browser: install one"; fi
            if [ -n "$PASSWORDS_CMD" ]; then entry passwords "Password manager"
            elif [ -n "$IN_SWAY" ] && [ -n "$HAS_UPDATE" ]; then entry passwords "Password manager: install one"; fi
            entry terminal Terminal "$IN_SWAY"
            entry apps Apps "$HAS_UPDATE$EDITOR_CMD$FILES_CMD$SIGNAL_CMD$SIMPLEX_CMD$CLAUDE_CMD$OPENCODE_CMD$TOR_CMD$WHONIX_CMD$GIMP_CMD$SPARROW_CMD$FEATHER_CMD$ELECTRUM_CMD"
            entry network Wi-Fi "$HAS_WIFI$NMTUI_CMD$WIFI_SCRIPT$SIGNIN_CMD"
            entry settings Settings "$THEME_CMD${other_radios[*]}$VAULT_CMD$SECDNS_CMD$FONT_CMD"
            entry system System "$HAS_UPDATE$BACKUP_CMD$AUTOSTART_CMD"
            entry power Power
            entry help Help ;;
        apps)
            entry apps-install "Install apps" "$HAS_UPDATE"
            entry tor "Tor Browser" "$TOR_CMD"
            entry whonix Whonix "$WHONIX_CMD"
            entry editor "Text editor" "$EDITOR_CMD"
            entry files "File manager" "$FILES_CMD"
            entry gimp GIMP "$GIMP_CMD"
            entry signal Signal "$SIGNAL_CMD"
            entry simplex SimpleX "$SIMPLEX_CMD"
            entry sparrow Sparrow "$SPARROW_CMD"
            entry feather Feather "$FEATHER_CMD"
            entry electrum Electrum "$ELECTRUM_CMD"
            entry claude Claude "$CLAUDE_CMD"
            # (a window of its own, which it opens itself)
            entry opencode opencode "$OPENCODE_CMD"
            entry remove "Remove apps" "$HAS_UPDATE"
            entry back Back ;;
        network)
            entry choose "Choose a network" "$NMTUI_CMD$WIFI_SCRIPT"
            entry wifi "" "$HAS_WIFI"
            entry signin "Sign-in page" "$SIGNIN_CMD"
            entry back Back ;;
        settings)
            entry theme "" "$THEME_CMD"
            for r in "${other_radios[@]}"; do entry "$r" ""; done
            # the vault's own switch: closed, it asks for the vault's password
            entry vault "" "$VAULT_CMD"
            entry securedns "" "$SECDNS_CMD"
            entry font "Font size" "$FONT_CMD"
            entry back Back ;;
        system)
            entry update Update "$HAS_UPDATE"
            entry status Status "$HAS_UPDATE"
            entry backup "Back up now" "$BACKUP_CMD"
            entry autostart "Startup programs" "$AUTOSTART_CMD"
            entry back Back ;;
        power)
            entry lock Lock "$IN_SWAY"
            entry suspend Suspend
            entry logout "Log out" "$IN_SWAY"
            entry reboot Reboot
            entry shutdown "Shut down"
            entry back Back ;;
    esac
    n=${#ids[@]}
    refresh_items
}
# go LEVEL: to that screen, the cursor on its first entry (or, back on the first
# screen, on the list you came from)
go() {
    local from=$level i
    level=$1
    build
    sel=0
    for i in "${!ids[@]}"; do
        if [ "${ids[i]}" = "$from" ]; then sel=$i; fi
    done
}

# radio_label NAME: what the entry shows, e.g. "Wi-Fi: on"
radio_label() {
    local name state
    if [ "$1" = theme ]; then
        state=$("$THEME_CMD" 2>/dev/null)
        state=${state#Theme: }
        printf 'Theme: %s' "${state^}"
        return
    fi
    if [ "$1" = securedns ]; then
        printf 'Secure DNS: %s' "$("$SECDNS_CMD" status 2>/dev/null || echo unknown)"
        return
    fi
    if [ "$1" = vault ]; then
        state=$("$VAULT_CMD" status 2>/dev/null)
        printf 'Vault: %s' "${state%% *}"
        return
    fi
    case $1 in wifi) name=Wi-Fi ;; bluetooth) name=Bluetooth ;; mic) name=Microphone ;; camera) name=Webcam ;; esac
    state=$("$RADIOS" "$1" status 2>/dev/null)
    case $state in
        blocked) state="off (hardware switch)" ;;
        "") state="unknown" ;;
    esac
    printf '%s: %s' "$name" "$state"
}
# settings_label: the first screen's line: what matters at a glance, whatever
# is in the list ("Settings: mic off, camera off, DNS on")
settings_label() {
    local r said=''
    for r in "${radio_ids[@]}"; do
        case $r in
            mic) said+=", mic $("$RADIOS" mic status 2>/dev/null)" ;;
            camera) said+=", camera $("$RADIOS" camera status 2>/dev/null)" ;;
        esac
    done
    if [ -n "$SECDNS_CMD" ]; then said+=", DNS $("$SECDNS_CMD" status 2>/dev/null || echo unknown)"; fi
    printf 'Settings%s' "${said:+: ${said#, }}"
}
refresh_items() {
    local i
    for i in "${!ids[@]}"; do
        case ${ids[i]} in
            settings) items[i]=$(settings_label) ;;
            wifi | bluetooth | mic | camera | vault | theme | securedns) items[i]=$(radio_label "${ids[i]}") ;;
        esac
    done
}
level=top
sel=0
width=44
first_row=1 first_col=1
build

# level_title: where you are, after the title
level_title() {
    case $level in
        top) ;;
        network) echo " > Wi-Fi" ;;
        *) echo " > ${level^}" ;;
    esac
}

# draw: the title, the choices (the chosen one reversed), and a hint, centered
draw() {
    local rows cols top left i y
    size=$(stty size 2>/dev/null || echo "24 80")
    read -r rows cols <<<"$size"
    top=$(((rows - n - 4) / 2 + 1))
    [ "$top" -ge 1 ] || top=1
    left=$(((cols - width) / 2 + 1))
    [ "$left" -ge 1 ] || left=1
    first_row=$((top + 2))
    first_col=$left
    printf '\e[2J\e[%d;%dH\e[1mWren Linux%s\e[0m' "$top" "$left" "$(level_title)"
    for i in "${!items[@]}"; do
        y=$((first_row + i))
        if [ "$i" -eq "$sel" ]; then
            printf '\e[%d;%dH\e[7m %-*s \e[0m' "$y" "$left" $((width - 2)) "${items[i]}"
        else
            printf '\e[%d;%dH %-*s ' "$y" "$left" $((width - 2)) "${items[i]}"
        fi
    done
    if [ "$level" = top ]; then
        printf '\e[%d;%dH\e[2mEnter or click; Esc closes\e[0m' $((first_row + n + 1)) "$left"
    else
        printf '\e[%d;%dH\e[2mEnter or click; Space switches; Esc goes back\e[0m' $((first_row + n + 1)) "$left"
    fi
}

# run_choice: runs the chosen entry in this window
run_choice() {
    local out
    case ${ids[sel]} in
        apps | network | settings | system | power)
            go "${ids[sel]}"
            return 0 ;;
        back)
            go top
            return 0 ;;
        autostart)
            screen_off
            printf '\e[2J\e[1;1H'
            "$AUTOSTART_CMD" edit
            screen_on
            settle
            return 0 ;;
        wifi | bluetooth | mic | camera)
            "$RADIOS" "${ids[sel]}" toggle >/dev/null 2>&1
            refresh_items
            return 0 ;;
        securedns)
            # Switching on checks that names resolve (up to 20 seconds), and
            # either way it says what to do next: shown on this window's screen
            screen_off
            printf '\e[2J\e[1;1HSwitching secure DNS...\n\n'
            "$SECDNS_CMD" toggle || true
            printf '\nPress Enter to go back. '
            wait_enter
            screen_on
            settle
            refresh_items
            return 0 ;;
        theme)
            # (this window keeps its colors; the next ones open in the new theme)
            "$THEME_CMD" toggle >/dev/null 2>&1
            refresh_items
            return 0 ;;
        terminal)
            swaymsg exec foot >/dev/null 2>&1
            exit 0 ;;
        browser | passwords)
            local cmd=$BROWSER
            [ "${ids[sel]}" = browser ] || cmd=$PASSWORDS_CMD
            if [ -z "$cmd" ]; then
                # not installed yet: the list to install it from
                ids[sel]=apps-install
                run_choice
                return
            fi
            swaymsg exec "$cmd" >/dev/null 2>&1
            exit 0 ;;
        files | signal | simplex | claude | opencode | signin | tor | whonix | gimp | sparrow | feather | electrum)
            local cmd
            case ${ids[sel]} in
                signin) cmd=$SIGNIN_CMD ;;
                files) cmd=$FILES_CMD ;;
                signal) cmd=$SIGNAL_CMD ;;
                simplex) cmd=$SIMPLEX_CMD ;; claude) cmd=$CLAUDE_CMD ;;
                opencode) cmd=$OPENCODE_CMD ;;
                tor) cmd=$TOR_CMD ;; whonix) cmd=$WHONIX_CMD ;; gimp) cmd=$GIMP_CMD ;;
                sparrow) cmd=$SPARROW_CMD ;; feather) cmd=$FEATHER_CMD ;; electrum) cmd=$ELECTRUM_CMD ;;
            esac
            swaymsg exec "$cmd" >/dev/null 2>&1
            exit 0 ;;
        choose)
            # nmtui draws in this window; without NetworkManager, wifi.sh asks here
            screen_off
            printf '\e[2J\e[1;1H'
            if [ -n "$NMTUI_CMD" ]; then
                "$NMTUI_CMD" || true
            else
                (cd "$DIR" && bash wifi.sh) || true
                printf '\nPress Enter to go back. '
                wait_enter
            fi
            screen_on
            settle
            refresh_items
            return 0 ;;
        # As bin/powermenu does; the lock through sway, so it outlives this window
        lock)
            if [ -x "$HOME/.local/bin/wren-lock" ]; then swaymsg exec "$HOME/.local/bin/wren-lock" >/dev/null 2>&1
            else swaymsg exec "swaylock -f -c 000000" >/dev/null 2>&1; fi
            exit 0 ;;
        suspend) systemctl suspend; exit 0 ;;
        logout) swaymsg exit >/dev/null 2>&1; exit 0 ;;
        reboot) systemctl reboot; exit 0 ;;
        shutdown) systemctl poweroff; exit 0 ;;
        vault)
            if "$VAULT_CMD" status 2>/dev/null | grep -q '^open'; then
                "$VAULT_CMD" close >/dev/null 2>&1
            else
                # It asks for the vault's password: on this window's own screen
                screen_off
                printf '\e[2J\e[1;1HOpening the vault (for an hour; vault open --for 2h in a terminal for longer).\n\n'
                "$VAULT_CMD" open || true
                printf '\nPress Enter to go back. '
                wait_enter
                screen_on
                settle
            fi
            refresh_items
            return 0 ;;
        backup)
            screen_off
            printf '\e[2J\e[1;1HBacking up your home folder.\n\n'
            "$BACKUP_CMD" || printf '\nThe backup stopped with an error (see above).\n'
            printf '\nPress Enter to go back. '
            wait_enter
            screen_on
            settle ;;
        editor)
            swaymsg exec "$EDITOR_CMD" >/dev/null 2>&1
            exit 0 ;;
        font)
            # console-font lists the sizes and asks; leave the menu's screen
            # for it, then come back to the menu
            screen_off
            printf '\e[2J\e[1;1H'
            "$FONT_CMD"
            printf '\nPress Enter to go back. '
            wait_enter
            screen_on
            settle ;;
        help)
            # the sheet without the lines for things that are not installed
            mapfile -t lines < <("$HOME/.local/bin/keys" --text 2>/dev/null || cat "$KEYS_FILE")
            pager ;;
        status)
            REDRAW=
            printf '\e[2J\e[1;1HLooking at what is set up...'
            out=$(cd "$DIR" && bash status.sh 2>&1)
            mapfile -t lines <<<"$out"
            pager ;;
        apps-install | remove | update)
            trap - EXIT
            screen_off
            cd "$DIR" || exit 1
            export WREN_PAUSE=1
            # The scripts wait for a key at their end (pause_if_asked), which
            # marks this file; one that stops on an error before that would
            # close the window at once, so this waits instead
            WREN_PAUSED_FILE=$(mktemp -u "${TMPDIR:-/tmp}/wren-paused.XXXXXX")
            export WREN_PAUSED_FILE
            local rc log=
            # Busy: a click on Wren Linux in the bar now brings this window to the
            # front instead of closing it (bin/sway-status), so nothing is cut off
            local busy=${XDG_RUNTIME_DIR:-/tmp}/wren-menu-busy
            echo $$ >"$busy"
            if [ "${ids[sel]}" = update ]; then
                # What Update prints is also kept, for a look afterwards
                log=${XDG_STATE_HOME:-$HOME/.local/state}/wren/menu-update.log
                mkdir -p "${log%/*}"
                bash update.sh 2>&1 | tee "$log"
                rc=${PIPESTATUS[0]}
            else
                if [ "${ids[sel]}" = remove ]; then bash install-extras.sh --remove; else bash install-extras.sh; fi
                rc=$?
            fi
            if [ "$rc" -ne 0 ] && [ ! -e "$WREN_PAUSED_FILE" ]; then
                printf '\nIt stopped with an error (status %s).%s\nPress Enter to close. ' \
                    "$rc" "${log:+ What it printed is in $log}" >&2
                wait_enter
            fi
            rm -f "$WREN_PAUSED_FILE" "$busy"
            exit "$rc" ;;
    esac
}

screen_on
settle
REDRAW=draw
while :; do
    draw
    read_key
    case $KEY in
        enter) run_choice ;;
        # Space flips a switch (Wi-Fi, Bluetooth, microphone, webcam, theme,
        # secure DNS); on anything else it does nothing, so it never opens a program
        space) case ${ids[sel]} in wifi | bluetooth | mic | camera | theme | securedns) run_choice ;; esac ;;
        down | j) sel=$(((sel + 1) % n)) ;;
        up | k) sel=$(((sel + n - 1) % n)) ;;
        wheeldown) sel=$(((sel + 1) % n)) ;;
        wheelup) sel=$(((sel + n - 1) % n)) ;;
        esc | q)
            # a list goes back to the first screen, which closes
            [ "$level" != top ] || exit 0
            go top ;;
        click)
            i=$((CY - first_row))
            if [ "$i" -ge 0 ] && [ "$i" -lt "$n" ] && [ "$CX" -ge "$first_col" ] && [ "$CX" -lt $((first_col + width)) ]; then
                sel=$i
                run_choice
            fi ;;
    esac
done
