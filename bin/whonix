#!/bin/sh
# whonix: written by Wren Linux extras/whonix.sh
#   whonix          start both VMs and open both, each on an empty workspace:
#                   the Gateway on this one if it is empty, else the next empty
#                   one to the right (or left), the Workstation on the next
#                   empty one after it, where you are left
#   whonix gateway  start the Gateway and open it (Tor settings)
#   whonix stop     shut both down, right away and cleanly: it presses each VM's
#                   power button (extras/whonix.sh makes that shut it down). Save
#                   your work inside first. One still running after
#                   WHONIX_STOP_WAIT seconds (30) is left running, and it says so.
#   whonix stop --force   the same, but one still running then is switched off,
#                   as if its power button were held
v="virsh -c qemu:///session"

# Started from Super+d there is no terminal: what went wrong is also shown as a
# notification, so it doesn't fail without a word
fail() {
    echo "whonix: $*" >&2
    [ -t 2 ] || notify-send -u critical Whonix "$*" 2>/dev/null || true
    exit 1
}
running() { [ "$($v domstate "$1" 2>/dev/null)" = running ]; }
# The Gateway's outside network (extras/whonix.sh gives it a card of Wren Linux's):
# passt with Whonix's fixed addresses, IPv4 only, no DHCP, nothing of this computer
# mapped in, and 10.0.2.3 where only DNS goes on, to the resolver this computer
# uses. It ends when the Gateway does (--one-off). A Gateway set up before this
# has libvirt's own and is left as it is.
GW_NET=$HOME/.local/state/wren
gateway_net() {
    $v dumpxml --inactive Whonix-Gateway 2>/dev/null | grep -q 'wren-gw-net' || return 0
    running Whonix-Gateway && return 0
    command -v passt >/dev/null || fail "passt is missing. Run: wrenctl install whonix"
    mkdir -p "$GW_NET"
    chmod 700 "$GW_NET"
    rm -f "$GW_NET/whonix-gateway-net.sock"
    passt --quiet --one-off --socket "$GW_NET/whonix-gateway-net.sock" --pid "$GW_NET/whonix-gateway-net.pid" \
        --ipv4-only --address 10.0.2.15 --netmask 24 --gateway 10.0.2.2 \
        --no-map-gw --dns-forward 10.0.2.3 --no-dhcp ${WHONIX_NET_PCAP:+--pcap "$WHONIX_NET_PCAP"} ||
        fail "couldn't start the Gateway's network (passt)."
}
up() {
    running "$1" && return 0
    # (its error message, not its output)
    # shellcheck disable=SC2069  # this order on purpose: keeps the error, drops the output
    err=$($v start "$1" 2>&1 >/dev/null) || fail "couldn't start $1: $err"
}
# console VM: its window, and back once that is open. virt-manager can stay in
# front until its window closes, so it runs on its own, with what it says in a
# file (mostly noise about audio). A second one hands its window to the first,
# which has to be up by then: outside sway, where nothing shows that, it gets a moment.
console() {
    command -v virt-manager >/dev/null || fail "virt-manager is missing. Run: wrenctl install whonix"
    mkdir -p "$GW_NET"
    log=$GW_NET/$1-console.log
    setsid virt-manager -c qemu:///session --show-domain-console "$1" >"$log" 2>&1 </dev/null &
    if ! in_sway; then
        sleep 3
        return 0
    fi
    end=$(($(date +%s) + ${WHONIX_WINDOW_WAIT:-60}))
    until sway_ask open "$1"; do
        [ "$(date +%s)" -lt "$end" ] || fail "couldn't open the window of $1. What virt-manager said: $log"
        sleep 0.25
    done
}

in_sway() { [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null; }
# In sway, with workspaces (not extras/one-workspace.sh: there the two share
# the one screen), each window gets an empty workspace of its own
spread() {
    in_sway || return 1
    [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/one-workspace.conf" ]
}
# sway_ask empty [AFTER]: the number of an empty workspace (1-10). Without
# AFTER, the one you are on if it is empty; else, and with AFTER, the next one
# to the right of it (or of AFTER), or else to the left. None free: nothing.
# sway_ask open TITLE: is a window "TITLE on ..." (virt-manager's) open?
sway_ask() {
    swaymsg -t get_tree 2>/dev/null | python3 -I -c '
import json, sys
used, here, titles = set(), None, []
def walk(n, ws=None):
    global here
    if n.get("type") == "workspace":
        ws = n.get("num", -1)
    if n.get("focused") and ws is not None:
        here = ws
    if n.get("pid"):
        titles.append(n.get("name") or "")
        if ws is not None:
            used.add(ws)
    for c in n.get("nodes", []) + n.get("floating_nodes", []):
        walk(c, ws)
walk(json.load(sys.stdin))
if sys.argv[1] == "open":
    sys.exit(0 if any(sys.argv[2] + " on " in t for t in titles) else 1)
after = int(sys.argv[2]) if len(sys.argv) > 2 else None
start = after if after is not None else (here if here and here > 0 else 1)
order = ([] if after is not None else [start]) + list(range(start + 1, 11)) + list(range(start - 1, 0, -1))
print(next((w for w in order if w not in used), ""))
' "$@"
}
# window_to TITLE WORKSPACE: once the window is there (virt-manager takes a
# moment), it goes to that workspace, and so do you
window_to() {
    i=0
    while [ "$i" -lt 40 ]; do
        swaymsg "[title=\"$1 on \"] move container to workspace number $2, workspace number $2" >/dev/null 2>&1 && return 0
        sleep 0.25
        i=$((i + 1))
    done
}
open_both() {
    if ! spread; then
        console Whonix-Gateway && console Whonix-Workstation
        return
    fi
    gw=
    if ! sway_ask open Whonix-Gateway && gw=$(sway_ask empty) && [ -n "$gw" ]; then
        console Whonix-Gateway && window_to Whonix-Gateway "$gw"
    else
        console Whonix-Gateway
    fi
    if ! sway_ask open Whonix-Workstation && ws=$(sway_ask empty ${gw:+"$gw"}) && [ -n "$ws" ]; then
        console Whonix-Workstation && window_to Whonix-Workstation "$ws"
    else
        console Whonix-Workstation
    fi
}
stop() {
    for vm in Whonix-Workstation Whonix-Gateway; do
        if running "$vm"; then $v shutdown "$vm" >/dev/null 2>&1 || true; fi
    done
    i=0
    while [ "$i" -lt "${WHONIX_STOP_WAIT:-30}" ] && { running Whonix-Workstation || running Whonix-Gateway; }; do
        sleep 1
        i=$((i + 1))
    done
    if [ "${1:-}" != --force ]; then
        left=0
        for vm in Whonix-Workstation Whonix-Gateway; do
            running "$vm" || continue
            echo "whonix: $vm is still running. Installed before whonix stop could shut it down, it shows a dialog: choose Shutdown there. Stuck? whonix stop --force switches it off (it can leave its disk needing repair)." >&2
            left=1
        done
        return "$left"
    fi
    # The Workstation first: the Gateway is its only way out
    for vm in Whonix-Workstation Whonix-Gateway; do
        running "$vm" || continue
        echo "whonix: $vm didn't shut down by itself; switching it off." >&2
        # --graceful: QEMU is asked to end and closes its disk cleanly
        $v destroy --graceful "$vm" >/dev/null 2>&1 || $v destroy "$vm" >/dev/null 2>&1 ||
            echo "whonix: couldn't switch $vm off." >&2
    done
    true
}

# webtunnel's program in the Gateway (extras/whonix.sh copies it in): Whonix doesn't
# update that copy, so this says when the one here, updated by apt, is newer
lyrebird_check() {
    f=$GW_NET/whonix-lyrebird-version
    [ -s "$f" ] || return 0
    have=$(dpkg-query -W -f='${Version}' lyrebird 2>/dev/null) || return 0
    dpkg --compare-versions "$have" gt "$(cat "$f")" || return 0
    msg="lyrebird $have is out; the Gateway has $(cat "$f"). Copy it in: whonix stop, then wrenctl install whonix --bridges"
    echo "whonix: $msg" >&2
    [ -t 2 ] || notify-send Whonix "$msg" 2>/dev/null || true
}

case "${1:-start}" in
    start) lyrebird_check; gateway_net && up Whonix-Gateway && up Whonix-Workstation && open_both ;;
    gateway) lyrebird_check; gateway_net && up Whonix-Gateway && console Whonix-Gateway ;;
    stop)
        case ${2:-} in
            "" | --force) stop "${2:-}" ;;
            *) echo "usage: whonix stop [--force]" >&2; exit 2 ;;
        esac ;;
    *) echo "usage: whonix [start|gateway|stop [--force]]" >&2; exit 2 ;;
esac
