#!/bin/sh
# whonix: written by Wren Linux extras/whonix.sh
#   whonix          start both VMs and open the Workstation
#   whonix gateway  start the Gateway and open it (Tor settings)
#   whonix stop     shut both down. Each is asked to shut down first; Whonix's
#                   desktop answers that with a dialog, so one still running
#                   after WHONIX_STOP_WAIT seconds (20) is switched off, as if
#                   its power button were held. Save your work inside first.
v="virsh -c qemu:///session"

# Started from Super+d there is no terminal: what went wrong is also shown as a
# notification, so it doesn't fail without a word
fail() {
    echo "whonix: $*" >&2
    [ -t 2 ] || notify-send -u critical Whonix "$*" 2>/dev/null || true
    exit 1
}
running() { [ "$($v domstate "$1" 2>/dev/null)" = running ]; }
# The Gateway's outside network (extras/whonix.sh gives it a card of Wren Linux's):
# passt with Whonix's fixed addresses, IPv4 only, no DHCP, nothing of this computer
# mapped in, and 10.0.2.3 where only DNS goes on, to the resolver this computer
# uses. It ends when the Gateway does (--one-off). A Gateway set up before this
# has libvirt's own and is left as it is.
GW_NET=$HOME/.local/state/wren
gateway_net() {
    $v dumpxml --inactive Whonix-Gateway 2>/dev/null | grep -q 'wren-gw-net' || return 0
    running Whonix-Gateway && return 0
    command -v passt >/dev/null || fail "passt is missing. Run: wrenctl install whonix"
    mkdir -p "$GW_NET"
    chmod 700 "$GW_NET"
    rm -f "$GW_NET/whonix-gateway-net.sock"
    passt --quiet --one-off --socket "$GW_NET/whonix-gateway-net.sock" --pid "$GW_NET/whonix-gateway-net.pid" \
        --ipv4-only --address 10.0.2.15 --netmask 24 --gateway 10.0.2.2 \
        --no-map-gw --dns-forward 10.0.2.3 --no-dhcp ${WHONIX_NET_PCAP:+--pcap "$WHONIX_NET_PCAP"} ||
        fail "couldn't start the Gateway's network (passt)."
}
up() {
    running "$1" && return 0
    # (its error message, not its output)
    # shellcheck disable=SC2069  # this order on purpose: keeps the error, drops the output
    err=$($v start "$1" 2>&1 >/dev/null) || fail "couldn't start $1: $err"
}
console() {
    command -v virt-manager >/dev/null || fail "virt-manager is missing. Run: wrenctl install whonix"
    exec virt-manager -c qemu:///session --show-domain-console "$1"
}
stop() {
    for vm in Whonix-Workstation Whonix-Gateway; do
        if running "$vm"; then $v shutdown "$vm" >/dev/null 2>&1 || true; fi
    done
    i=0
    while [ "$i" -lt "${WHONIX_STOP_WAIT:-20}" ] && { running Whonix-Workstation || running Whonix-Gateway; }; do
        sleep 1
        i=$((i + 1))
    done
    # The Workstation first: the Gateway is its only way out
    for vm in Whonix-Workstation Whonix-Gateway; do
        running "$vm" || continue
        echo "whonix: $vm didn't shut down by itself (its shutdown dialog is open); switching it off." >&2
        # --graceful: QEMU is asked to end and closes its disk cleanly
        $v destroy --graceful "$vm" >/dev/null 2>&1 || $v destroy "$vm" >/dev/null 2>&1 ||
            echo "whonix: couldn't switch $vm off." >&2
    done
    true
}

case "${1:-start}" in
    start) gateway_net && up Whonix-Gateway && up Whonix-Workstation && console Whonix-Workstation ;;
    gateway) gateway_net && up Whonix-Gateway && console Whonix-Gateway ;;
    stop) stop ;;
    *) echo "usage: whonix [start|gateway|stop]" >&2; exit 2 ;;
esac
