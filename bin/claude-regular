#!/bin/bash
# claude-regular [--account NAME] [ARGS...]: written by Wren Linux extras/claude-regular.sh
# Claude Code as you, in the folder you start it from, with your files and the
# deny rules Wren Linux added to ~/.claude/settings.json. (claude, from
# extras/claude-code.sh, runs it as its own user instead.)
# --account NAME: another account, with its own login, memories and settings
# in ~/.claude-NAME (set up with extras/claude-regular.sh --account NAME). It
# still runs as you: not walled off from the first.
set -euo pipefail
die() { printf 'claude-regular: %s\n' "$*" >&2; exit 1; }
account=
case ${1:-} in
    --account) [ $# -ge 2 ] || die "--account needs a name: claude-regular --account NAME"; account=$2; shift 2 ;;
    --account=*) account=${1#--account=}; shift ;;
esac
if [ -n "$account" ]; then
    [[ $account =~ ^[a-z][a-z0-9]{0,14}$ ]] || die "an account name is small letters and digits, a letter first."
    [ -f "$HOME/.claude-$account/settings.json" ] ||
        die "the account $account isn't set up. Run: wrenctl install claude-regular --account $account"
    export CLAUDE_CONFIG_DIR=$HOME/.claude-$account
fi
# Claude Code's theme follows the terminal's, unless one was chosen already
seed_theme() { # CONFIG-FILE
    python3 -I - "$1" 2>/dev/null <<'PY' || true
import json, os, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
except FileNotFoundError:
    d = {}
if isinstance(d, dict) and "theme" not in d:
    d["theme"] = "auto"
    with os.fdopen(os.open(p + ".wren-new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(d, f, indent=2)
    os.replace(p + ".wren-new", p)
PY
}
seed_theme "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
# Before the first sign-in (no login saved yet), in a terminal: how to sign
# in, as the sandboxed Firefox can't finish Claude Code's own way
first_signin_note() { # CONFIG-FOLDER ARGS...
    local dir=$1
    shift
    [ ! -s "$dir/.credentials.json" ] && [ -z "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || return 0
    [ -t 0 ] && [ -t 1 ] || return 0
    case ${1:-} in -v | --version | -h | --help | -p | --print) return 0 ;; esac
    echo "Signing in to Claude: the sandboxed Firefox's firewall blocks the sign-in"
    echo "page's way back to this computer, so Claude Code can't finish it there. Open"
    echo "the link it prints in Firefox, sign in, and paste the code you get back here."
    read -rp 'Press Enter to go on. ' _ || true
}
first_signin_note "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$@"
# Links it opens go through claude-open-link, which skips the sign-in link the
# sandboxed Firefox can't finish (Claude Code then shows the one with a code)
opener=$(dirname -- "${BASH_SOURCE[0]}")/claude-open-link
if [ -x "$opener" ]; then export BROWSER=$opener; fi
exec /usr/bin/claude "$@"
