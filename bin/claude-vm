#!/bin/bash
# claude-vm [connect|resume|unattended|shell|status|stop|pubkey|rebuild]: written by Wren Linux
# extras/claude-vm.sh
# Claude Code inside a disposable virtual machine, not on your computer. The
# VM has its own disk and no shared folder with you: the agent's only way to
# hand work back is to push to a git host you pull from (claude-pull). It can
# reach the internet but nothing on your machine or local network.
#   claude-vm            start the VM, run Claude Code in it, power it off on exit
#   claude-vm resume     the same, going on with an earlier conversation: Claude Code
#                        lists them (also: claude-vm --resume)
#   claude-vm unattended the same, with Claude Code's own permission prompts off, for
#                        leaving it to work: a prompt nobody answers stops the work
#   claude-vm shell      a plain shell in the VM
#   claude-vm status     is the VM running?
#   claude-vm stop       power the VM off
#   claude-vm pubkey     the VM's ssh public key (add it on your git host)
#   claude-vm bundle NAME  the VM's branch claude of ~/projects/NAME, as a git bundle
#                        on standard output (claude-pull uses it)
#   claude-vm reset      back to how it was built (faster than rebuild; asks first)
#   claude-vm rebuild    throw the VM away and build a fresh one (asks first; offers its new key to GitHub)
#   claude-vm --account NAME [COMMAND]   another account's VM (its own Claude
#                        login and memories); set up with extras/claude-vm.sh --account NAME
# Started from a launcher (wmenu on Super+d), claude-vm and claude-vm shell
# open their own foot window, which stays open after an error so you can read it.
# To run Claude Code directly on your machine as yourself instead, with your
# files, install it normally (see extras/claude-code.sh).
set -euo pipefail

AGENT=claude-vm
SESSION=/usr/local/libexec/claude-vm-session

# hold: in the window opened below, keep what went wrong on screen until Enter
hold() {
    [ -n "${CLAUDE_VM_HOLD:-}" ] || return 0
    printf '\nPress Enter to close this window.' >&2
    read -r _ || true
}
die() { printf 'claude-vm: %s\n' "$*" >&2; hold; exit 1; }

[ "$(id -u)" -ne 0 ] || die "run it as your normal user, not root."

account=
case ${1:-} in
    --account) [ $# -ge 2 ] || die "--account needs a name: claude-vm --account NAME"; account=$2; shift 2 ;;
    --account=*) account=${1#--account=}; shift ;;
esac
if [ -n "$account" ]; then
    [[ $account =~ ^[a-z][a-z0-9]{0,14}$ ]] || die "an account name is small letters and digits, a letter first."
    AGENT=claude-vm-$account
fi

cmd=${1:-connect}
case "$cmd" in
    --resume) cmd=resume ;;
    connect | resume | unattended | shell | status | stop | pubkey | rebuild | reset) ;;
    bundle)
        [ $# -eq 2 ] || die "usage: claude-vm bundle NAME (a folder in the VM's ~/projects)"
        [ ! -t 1 ] || die "that writes a git bundle, not text: send it to a file (claude-pull does)." ;;
    -h | --help)
        sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    *) die "unknown command '$1'. Try: claude-vm --help" ;;
esac

# Started from wmenu or another launcher there is no terminal to talk in, and
# ssh would quietly give up: open one in sway and run again inside it. (No
# controlling terminal, /dev/tty: what sway starts gets tty1 as stdin, out of sight)
if [ "$cmd" = connect ] || [ "$cmd" = resume ] || [ "$cmd" = unattended ] || [ "$cmd" = shell ]; then
    if ! { : </dev/tty; } 2>/dev/null && [ -n "${WAYLAND_DISPLAY:-}" ] && command -v foot >/dev/null; then
        exec foot --title="Claude (VM${account:+ $account})" env CLAUDE_VM_HOLD=1 "$0" ${account:+--account "$account"} "$cmd"
    fi
fi

if [ -n "$account" ]; then
    sudo -n -u "$AGENT" -l "$SESSION" >/dev/null 2>&1 ||
        die "the account $account isn't set up. Run: wrenctl install claude-vm --account $account"
fi
sudo -n -u "$AGENT" -l "$SESSION" >/dev/null 2>&1 ||
    die "the VM sandbox isn't set up. Run: wrenctl install claude-vm"

if [ "$cmd" = unattended ]; then
    echo "Unattended: the agent does what it decides without asking, what a web page talks it into too. The VM, its firewall and your review of what it pushes still hold."
fi

if [ "$cmd" = reset ]; then
    printf 'This deletes everything in the VM since it was built, unpushed work and your Claude login too. Go on? [y/N] '
    IFS= read -r a || a=
    [[ $a =~ ^[Yy] ]] || { echo "Nothing was changed."; exit 0; }
fi

# A rebuilt VM has a new ssh key, which the git host doesn't know yet. Offered only
# on a terminal and only after a build that worked; Enter sends nothing.
if [ "$cmd" = rebuild ]; then
    printf 'This deletes the VM and everything in it, unpushed work and your Claude login too, then builds a new one. Go on? [y/N] '
    IFS= read -r a || a=
    [[ $a =~ ^[Yy] ]] || { echo "Nothing was changed."; exit 0; }
    sudo -n -u "$AGENT" "$SESSION" rebuild
    if { [ -t 0 ] || [ -n "${WREN_TEST_ANSWERS:-}" ]; } && command -v wrenctl >/dev/null; then
        printf 'Add the new VM key to GitHub so the agent can push (wrenctl gh deploy-key)? [y/N] '
        IFS= read -r a || a=
        if [[ $a =~ ^[Yy] ]]; then
            wrenctl gh deploy-key ${account:+--account "$account"} ||
                echo "The key wasn't added. To try again: wrenctl gh deploy-key${account:+ --account $account}" >&2
        fi
    fi
    exit 0
fi

if [ -n "${CLAUDE_VM_HOLD:-}" ]; then
    rc=0
    sudo -n -u "$AGENT" "$SESSION" "$cmd" || rc=$?
    [ "$rc" -eq 0 ] || hold
    exit "$rc"
fi
if [ "$cmd" = bundle ]; then exec sudo -n -u "$AGENT" "$SESSION" bundle "$2"; fi
exec sudo -n -u "$AGENT" "$SESSION" "$cmd"
