#!/bin/bash
# claude-share PATH...: written by Wren Linux extras/claude-code.sh
# Gives Claude files to look at, on a branch of their own on GitHub.
#   claude-share ~/Pictures/Wallpapers     shows what would go up, then asks
#   claude-share --done                    deletes the branches it made, after asking
# The repository is public: whatever goes up can be seen and copied at once, and
# deleting the branch later doesn't take that back. So it shows every name first.
# It goes to the repository you're in, else this Wren Linux's own git copy.
# The branch holds one new commit and nothing else, so it brings no history along and
# can't touch main. That commit doesn't carry your name, email or time zone. Hidden files
# and links are left out. Claude looks and picks; nothing here goes into main by itself.
set -euo pipefail

MAX_FILE_MB=50   # GitHub warns at 50 MB and refuses at 100
MAX_ALL_MB=200

die() { printf 'claude-share: %s\n' "$*" >&2; exit 1; }

# wren_copy: the Wren Linux folder this was run from, else the one wrenctl knows
wren_copy() {
    local here
    here=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/..
    if [ -f "$here/lib.sh" ]; then echo "$here"; else wrenctl --dir 2>/dev/null; fi
}
# the address of the repository
url=$(git remote get-url origin 2>/dev/null || git -C "$(wren_copy)" remote get-url origin 2>/dev/null) ||
    die "this isn't a git copy, and neither is Wren Linux's folder. Run it in your copy of the repository."

if [ "${1:-}" = --done ]; then
    mapfile -t branches < <(git ls-remote --heads "$url" 'claude-share-*' |
        sed -n 's|^[0-9a-f]*\trefs/heads/\(claude-share-[0-9-]*\)$|\1|p')
    [ ${#branches[@]} -gt 0 ] || { echo "No shared branches on $url."; exit 0; }
    printf '  %s\n' "${branches[@]}"
    read -rp "Delete these from $url? [y/N] " answer
    case $answer in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac
    git push --quiet "$url" --delete "${branches[@]}"
    echo "Deleted. GitHub can keep deleted data for a while, but a clone no longer gets it."
    exit 0
fi

if [ $# -eq 0 ] || [ "${1#-}" != "$1" ]; then die "usage: claude-share PATH...   or: claude-share --done"; fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/share"
for path in "$@"; do
    [ -e "$path" ] || die "there is no $path."
    [ ! -L "$path" ] || die "$path is a link: name what it points to."
    real=$(realpath -- "$path")
    case $HOME/ in "$real"/*) die "$path holds your whole home folder: name the folder you mean." ;; esac
    # ~/.ssh, ~/.ssh/id_ed25519, ~/.gnupg...: where keys and passwords live
    case $real in */.*) die "$path is hidden, or in a hidden folder: copy it elsewhere, if you do mean it." ;; esac
    if [ -d "$path" ]; then
        # only regular files, and nothing hidden at any depth
        (cd "$path" && find . -type f -not -path '*/.*' -print0) |
            while IFS= read -r -d '' f; do
                mkdir -p "$work/share/${real##*/}/$(dirname "$f")"
                cp -- "$path/$f" "$work/share/${real##*/}/$f"
            done
    else
        [ -f "$path" ] || die "$path isn't a file or a folder."
        cp -- "$path" "$work/share/"
    fi
done

mapfile -d '' -t files < <(cd "$work/share" && find . -type f -print0 | sort -z)
[ ${#files[@]} -gt 0 ] || die "nothing to share there (hidden files and links are left out)."
big=$(cd "$work/share" && find . -type f -size +"$MAX_FILE_MB"M | head -3)
[ -z "$big" ] || die "over $MAX_FILE_MB MB, too big for GitHub: $big"
total=$(du -sm "$work/share" | cut -f1)
[ "$total" -le "$MAX_ALL_MB" ] || die "$total MB in all, over $MAX_ALL_MB MB. Share fewer."

echo "This goes up to a new branch of $url, where ANYONE can see it:"
# (%q: a file name can't steer your terminal)
for f in "${files[@]}"; do printf '  %q\n' "${f#./}"; done
echo "${#files[@]} files, about $total MB."
echo "Leave out your own photos (they can hold where they were taken) and anything private."
if command -v exiftool >/dev/null; then
    # shellcheck disable=SC2016  # exiftool's own variables
    located=$(cd "$work/share"; exiftool -q -r -if '$GPSLatitude' -p '$Directory/$FileName' . 2>/dev/null || true)
    [ -z "$located" ] || { echo "THESE SAY WHERE THEY WERE TAKEN:"; printf '%s\n' "$located"; }
else
    echo "(Hidden details in the files weren't checked: exiftool isn't installed.)"
fi
read -rp "Share them? [y/N] " answer
case $answer in [yY]*) ;; *) echo "Nothing was shared."; exit 0 ;; esac

branch=claude-share-$(date -u +%Y%m%d-%H%M%S)
g() {
    TZ=UTC git -C "$work/share" -c core.hooksPath=/dev/null -c commit.gpgsign=false \
        -c user.name=claude-share -c user.email=claude-share@invalid "$@"
}
git -C "$work/share" init --quiet --template= --initial-branch="$branch"
g add --all
g commit --quiet -m "Files for Claude to look at, not for main"
g push --quiet "$url" "HEAD:refs/heads/$branch"
echo
echo "Shared. Tell Claude: $branch"
echo "When Claude is done with them: claude-share --done"
