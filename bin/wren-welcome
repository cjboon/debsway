#!/bin/sh
# The first sway login only: asks whether sway's shortcuts use Super or Alt,
# then shows the key cheat sheet (keys --welcome).
# Written by Wren Linux install-base.sh
marker=${XDG_STATE_HOME:-$HOME/.local/state}/wren/welcome-seen
[ -e "$marker" ] && exit 0
mkdir -p "${marker%/*}" && touch "$marker"
exec foot -o colors.alpha=0.85 --app-id=wren-keys "$HOME/.local/bin/keys" --welcome
