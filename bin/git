#!/bin/bash
# git [ARGS...]: written by Wren Linux extras/claude-code.sh
# Your git, with one guard. claude-agent can change any file in ~/projects,
# including the .git folder of a repository: a hook, or a setting such as
# core.fsmonitor, would run as YOU the next time you use git there. So inside
# ~/projects, before git runs, this looks at the repository's .git/config and
# .git/hooks, and refuses if it finds anything that can run a program. A repository
# that claude-agent made also gets git's "dubious ownership" warning; when the
# check passes, this trusts that one repository for that one command. A bare
# repository has no .git to look at, and claude-agent can make one in any folder
# there, so git is told to use one only when you name it (--git-dir).
# The same in ~/projects-NAME, the folder of another account (claude-agent-NAME,
# extras/claude-code.sh --account). Everywhere else it is plain git.
# /usr/bin/git skips the guard.
#
# (A file could change between the check and the run; it is a guard against a
# sloppy or confused assistant, not against one racing your keystrokes.)

shopt -s extglob
REAL=${WREN_REAL_GIT:-/usr/bin/git}
AGENT=${WREN_AGENT_USER:-claude-agent}
PROJECTS=${WREN_PROJECTS:-$HOME/projects}

no_bare=()
plain() { exec "$REAL" "${no_bare[@]}" "$@"; }

[ -z "${GIT_DIR:-}" ] || plain "$@"

# Where git will work: the folder you are in, moved by any leading -C
dir=$(pwd -P) || plain "$@"
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
    case ${args[i]} in
        -C)
            i=$((i + 1))
            [ $i -lt ${#args[@]} ] || plain "$@"
            case ${args[i]} in /*) dir=${args[i]} ;; *) dir=$dir/${args[i]} ;; esac
            dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || plain "$@"
            ;;
        -c) i=$((i + 1)) ;;
        --git-dir | --git-dir=* | --work-tree | --work-tree=*) plain "$@" ;;
        -*) ;;
        *) break ;;
    esac
    i=$((i + 1))
done

case $dir in
    "$PROJECTS" | "$PROJECTS"/* | "$PROJECTS"-* ) no_bare=(-c safe.bareRepository=explicit) ;;
esac

# The top of the repository that holds that folder
top=$dir
while [ ! -e "$top/.git" ]; do
    [ "$top" != / ] || plain "$@"
    top=${top%/*}
    [ -n "$top" ] || top=/
done
case $top in
    "$PROJECTS" | "$PROJECTS"/* | "$PROJECTS"-* ) ;;
    *) plain "$@" ;;
esac

# The settings that can't run anything. Anything else in .git/config is refused.
config_ok() { # KEY VALUE
    case $1 in
        core.repositoryformatversion | core.filemode | core.bare | core.logallrefupdates | core.ignorecase | \
            core.precomposeunicode | core.symlinks | core.autocrlf | core.eol | core.safecrlf | core.quotepath | \
            core.sparsecheckout | core.sparsecheckoutcone | extensions.objectformat | \
            user.name | user.email | pull.rebase | pull.ff | push.default | push.autosetupremote | \
            fetch.prune | fetch.prunetags) return 0 ;;
        remote.*.url | remote.*.pushurl | submodule.*.url) url_ok "$2"; return ;;
        remote.*.fetch | remote.*.push | remote.*.tagopt | remote.*.prune | remote.*.prunetags | \
            remote.*.mirror | remote.*.promisor | remote.*.partialclonefilter | submodule.*.active | \
            branch.*.remote | branch.*.merge | branch.*.rebase | branch.*.description | \
            branch.*.pushremote | branch.*.vscode-merge-base) return 0 ;;
    esac
    return 1
}

# A remote that is an ordinary address, not a helper program (ext::, fd::...)
url_ok() {
    [[ $1 =~ ^(https?|ssh|git|file)://[^[:space:]]+$ ]] && return 0
    [[ $1 =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+:[^[:space:]]*$ ]] && return 0
    [[ $1 =~ ^[A-Za-z0-9._/~+-][^[:space:]:]*$ ]] && return 0   # a folder
    return 1
}

problems=()

# check_gitdir GITDIR: its config and hooks, and those of its submodules
check_gitdir() {
    local gd=$1 f rec key val
    [ -d "$gd" ] || return 0
    [ ! -e "$gd/config.worktree" ] || problems+=("config.worktree")
    while IFS= read -r -d '' f; do
        while IFS= read -r -d '' rec; do
            if [[ $rec == *$'\n'* ]]; then key=${rec%%$'\n'*}; val=${rec#*$'\n'}; else key=$rec; val=; fi
            config_ok "$key" "$val" || problems+=("${f#"$gd"/}: $key")
        done < <("$REAL" config --file "$f" --list -z 2>/dev/null)
    done < <({ [ -f "$gd/config" ] && printf '%s\0' "$gd/config"; find "$gd/modules" -name config -type f -print0 2>/dev/null; })
    while IFS= read -r -d '' f; do
        case ${f##*/} in *.sample) ;; *) problems+=("${f#"$gd"/}") ;; esac
    done < <({ [ -L "$gd/hooks" ] && printf '%s\0' "$gd/hooks"; find "$gd/hooks" -mindepth 1 -print0 2>/dev/null; find "$gd/modules" -path '*/hooks/*' -print0 2>/dev/null; })
}

# pointer FILE: the folder FILE names, as git reads it: all of the file, less the line ends
# at its end. Fails on a name with a line break in it: git would take that as one name.
pointer() {
    local line
    line=$(<"$1") || return 1
    line=${line%%+($'\r')}
    [[ $line != *$'\n'* ]] || return 1
    printf '%s' "$line"
}
# inside BASE NAME: NAME as a real folder, from BASE if it isn't absolute
inside() {
    case $2 in /*) (cd -- "$2" 2>/dev/null && pwd -P) ;; *) (cd -- "$1/$2" 2>/dev/null && pwd -P) ;; esac
}

# check_dot_git TOP: everything TOP/.git leads to. What can't be followed is refused:
# git may read it differently, and what isn't looked at can't be vouched for.
check_dot_git() {
    local t=$1 gitdir line common
    if [ -d "$t/.git" ]; then
        gitdir=$t/.git
    elif [ -f "$t/.git" ]; then
        # a worktree or submodule: .git says where the real folder is
        line=$(pointer "$t/.git") && [[ $line == "gitdir: "* ]] && gitdir=$(inside "$t" "${line#gitdir: }") ||
            { problems+=("$t/.git: a file that doesn't lead to a folder"); return 0; }
    else
        return 0
    fi
    check_gitdir "$gitdir"
    if [ -f "$gitdir/commondir" ]; then
        line=$(pointer "$gitdir/commondir") && common=$(inside "$gitdir" "$line") ||
            { problems+=("$gitdir/commondir: doesn't lead to a folder"); return 0; }
        check_gitdir "$common"
    fi
}

# This one, and every one above it in that folder: a .git git doesn't take for a repository
# (an empty folder) sends it on up, and that is decided by more than this can see
t=$top
while :; do
    [ ! -e "$t/.git" ] && [ ! -L "$t/.git" ] || check_dot_git "$t"
    t=${t%/*}
    case $t in
        "$PROJECTS" | "$PROJECTS"/* | "$PROJECTS"-* ) ;;
        *) break ;;
    esac
done

# And every one inside it: git status goes into a repository recorded as a submodule, with
# what its own .git says (a setting there runs as you), and any folder can be that
while IFS= read -r -d '' d; do
    [ "$d" != "$top/.git" ] || continue
    n=${#problems[@]}
    check_dot_git "${d%/.git}"
    for ((p = n; p < ${#problems[@]}; p++)); do problems[p]="${d#"$top"/}: ${problems[p]}"; done
done < <(find "$top" -name .git -prune -print0 2>/dev/null)

if [ ${#problems[@]} -gt 0 ]; then
    {
        printf 'git: not running here. %s holds things that could run a program as you:\n' "${top/#$HOME/\~}/.git"
        printf '  %s\n' "${problems[@]}"
        echo "Look at them. Remove what you don't want, or, if you trust them, run /usr/bin/git yourself."
    } >&2
    exit 1
fi

# Clean. A repository claude-agent made would otherwise be refused for its owner
extra=()
# (or an account's user, claude-agent-NAME)
agent_owned() { local o; o=$(stat -c %U "$1" 2>/dev/null) && [[ $o == "$AGENT" || $o =~ ^"$AGENT"-[a-z][a-z0-9]*$ ]]; }
if agent_owned "$top/.git" || agent_owned "$top"; then
    extra=(-c "safe.directory=$top" -c "safe.directory=$top/*")
fi
exec "$REAL" "${no_bare[@]}" "${extra[@]}" "$@"
