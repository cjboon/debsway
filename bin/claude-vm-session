#!/bin/bash
# claude-vm-session SUBCOMMAND: written by debsway extras/claude-vm.sh
# Installed as /usr/local/libexec/claude-vm-session. Your user may run exactly
# this, as the claude-vm user, and nothing else (a rule in /etc/sudoers.d).
# The claude-vm command calls it. It drives the disposable VM (one
# qemu-system-x86_64 process, via the bundled mockvps-kvm) and logs you into
# the guest. Running as claude-vm is what keeps the guest off your network:
# QEMU's sockets are claude-vm's, and a firewall rule on that user allows the
# internet only (data/claude-vm-firewall.nft). Another account's user,
# claude-vm-NAME (claude-vm --account NAME), runs its own VM the same way, with
# the console port root gave it in /etc/debsway/claude-vm-ports.
set -euo pipefail

me=$(id -un)
[[ $me == claude-vm || $me =~ ^claude-vm-[a-z][a-z0-9]{0,14}$ ]] ||
    { echo "claude-vm-session: only for the claude-vm users." >&2; exit 1; }
# (|| true: with set -e, a failed lookup would end this without a word)
home=$(getent passwd "$me" | cut -d: -f6) || true
[ "$home" = "/home/$me" ] || { echo "claude-vm-session: unexpected home folder for $me." >&2; exit 1; }
port=2242 setup_arg=
if [ "$me" != claude-vm ]; then
    setup_arg=" --account ${me#claude-vm-}"
    port=$(awk -v n="${me#claude-vm-}" '$1 == n && $2 ~ /^[0-9]+$/ && $2 >= 2250 && $2 <= 2299 { print $2; exit }' \
        /etc/debsway/claude-vm-ports 2>/dev/null) || true
    [ -n "$port" ] || { echo "claude-vm-session: no console port for $me; run: debsway install claude-vm$setup_arg" >&2; exit 1; }
fi

# Run again without a way to reach XWayland's abstract socket, which any user
# can connect to (qemu and ssh below inherit this)
noabs=/usr/local/libexec/debsway-no-abstract-sockets
if [ -z "${DEBSWAY_NOABS:-}" ]; then
    [ -x "$noabs" ] || { echo "claude-vm-session: $noabs is missing. Run: bash extras/claude-vm.sh" >&2; exit 1; }
    export DEBSWAY_NOABS=1
    exec "$noabs" "$0" "$@"
fi

# Fixed configuration. The port must match the firewall rule (data/claude-vm-firewall.nft,
# and for an account the line extras/claude-vm.sh adds).
export HOME=$home
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=${LANG:-C.UTF-8}
# The VM engine reads SUDO_USER to decide whose kvm-group membership to check;
# we are already claude-vm (in the kvm group), so make it see that and never
# try to change another user's groups with a sudo it does not have.
unset SUDO_USER
export USER=$me LOGNAME=$me
export VM_NAME=$me
export VM_USER=agent
export SSH_HOST_IP=127.0.0.1
export SSH_HOST_PORT=$port
export WORKDIR=$HOME/vm
export WEB_TUNNEL=0

MOCKVPS=/usr/local/libexec/claude-vm-mockvps-kvm
PROVISION=$HOME/.config/claude-vm/provision.sh
KEY_FILE=$HOME/.ssh/${VM_NAME}_id

die() { printf 'claude-vm-session: %s\n' "$*" >&2; exit 1; }
mockvps() { [ -x "$MOCKVPS" ] || die "the VM engine is missing ($MOCKVPS); run extras/claude-vm.sh again."; "$MOCKVPS" "$@"; }

# Non-interactive, key-only ssh into the guest, independent of ~/.ssh/config.
guest_ssh() {
    ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
        -o HostKeyAlias="$VM_NAME" -o IdentitiesOnly=yes -o LogLevel=ERROR \
        -i "$KEY_FILE" -p "$SSH_HOST_PORT" "$VM_USER@$SSH_HOST_IP" "$@"
}

ensure_up() {
    is_installed || die "no VM yet. Set it up first: debsway install claude-vm${setup_arg}"
    if ! mockvps --status 2>/dev/null | grep -q Running; then
        # Say why the window is quiet: mockvps's own steps ("==> Waiting for
        # SSH"...) and errors, but not the summary it ends with
        echo "Starting the VM; this takes about a minute."
        mockvps --start 2>&1 | sed -un 's/^==> /  /p; /^\(ERROR\|WARNING\):/p' ||
            die "could not start the VM (see $WORKDIR/${VM_NAME}-run.log)."
    fi
}

# Run a command in the guest over ssh, then power the VM off unless another
# window is still logged in (our own ssh has ended, so who lists only others).
# The disk is kept, so unpushed work is still there next time.
session_then_stop() {
    local rc=0
    ssh -t -o StrictHostKeyChecking=accept-new -o HostKeyAlias="$VM_NAME" \
        -o IdentitiesOnly=yes -i "$KEY_FILE" -p "$SSH_HOST_PORT" "$VM_USER@$SSH_HOST_IP" "$1" || rc=$?
    if [ "$(guest_ssh 'who | wc -l' 2>/dev/null || echo 1)" = 0 ]; then
        echo "Powering the VM off."
        mockvps --stop >/dev/null 2>&1 || echo "claude-vm-session: could not power off; run: claude-vm stop" >&2
    fi
    return "$rc"
}

is_installed() { [ -s "$WORKDIR/$VM_NAME.qcow2" ]; }

case "${1:-connect}" in
    connect)
        ensure_up
        # -t for a real terminal; run Claude Code in the guest's projects folder
        session_then_stop 'cd ~/projects && exec claude'
        ;;
    shell)
        ensure_up
        session_then_stop 'cd ~/projects 2>/dev/null; exec bash -l'
        ;;
    status) mockvps --status ;;
    stop)   mockvps --stop ;;
    pubkey)
        ensure_up
        guest_ssh 'cat ~/.ssh/id_ed25519.pub'
        ;;
    install)
        # First build: the real user triggers this from extras/claude-vm.sh.
        # PROVISION installs Claude Code in the guest. It never replaces a VM
        # that is already there (mockvps --yes would delete it unasked, with
        # whatever the agent hasn't pushed): that is what rebuild is for.
        if is_installed; then
            echo "The VM is already built; kept as it is. For a fresh one: claude-vm rebuild"
            exit 0
        fi
        [ -f "$PROVISION" ] || die "the provisioning script is missing ($PROVISION); run extras/claude-vm.sh again."
        PROVISION_FILES="$PROVISION" mockvps --yes
        ;;
    rebuild)
        [ -f "$PROVISION" ] || die "the provisioning script is missing ($PROVISION); run extras/claude-vm.sh again."
        mockvps --uninstall --yes >/dev/null 2>&1 || true
        PROVISION_FILES="$PROVISION" mockvps --yes
        ;;
    uninstall) mockvps --uninstall --yes ;;
    *) die "unknown subcommand '$1' (connect, shell, status, stop, pubkey, install, rebuild, uninstall)." ;;
esac
